*.local
.DS_Store

# Local env — never commit real secrets
.env
.env.*
env.*
scripts/env/
!.env.example

# Operator-only env files: real Supabase service keys + admin PIN hashes.
# Created locally by the pre-cutover Netlify-env workflow, never committed.
scripts/env/

# `supabase link` writes the linked project ref here. Sensitive (it
# identifies your Supabase org + project) and operator-only.
supabase/.temp/

# Deno lockfile — only appears if you've run a Deno-based tool locally.
# Not part of the build; safe to ignore.
deno.lock

# Safety backup of netlify.toml (kept on disk as a reference for
# manual rollback; ignore to keep it out of git)
netlify.backup.toml

# Editor
.vscode/*
!.vscode/extensions.json
.idea

# Setup script output — may contain generated IDs but no secrets
# scripts/migrations.sql is safe to commit; setup-providers.sh reads .env so it's fine too

# Local Netlify folder
.netlify
.netlify-bundle-test/

# E2E test screenshots — generated on demand, not committed
e2e-screenshots/*.png

# Test artifacts — generated by `npm run test:all` and friends, never
# committed. Re-runnable from clean state.
coverage/
test-results/
playwright-report/
playwright/.cache/


# Netlify dev artifacts (Deno runtime used by some plugins)
deno.lock

# Operator-only scripts and docs (never committed; force-added on Integration branch)
HASHED-PIN/
ai-powered-growth-stack-playbook.md
step.sh

# Workspace noise — not part of the codebase
DatIQ\ Price\ Range.numbers
dist-extension/

# design-sync
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# Agent worktrees — scratch checkouts, never part of the codebase.
#
# Claude Code creates a full checkout per isolated agent under here; three of
# them from 2026-08 total 1.3 GB and each carries its own `.git`. Adding them
# does NOT add their files — git records an embedded-repository GITLINK pointing
# at a commit no clone can fetch, so the result is a repo that looks like it has
# submodules, cannot be cloned intact, and is 1.3 GB heavier for nothing.
#
# `.claude/` itself stays tracked: skills, commands and launch.json live there
# and are part of the project. Only the scratch worktrees are excluded.
.claude/worktrees/

# Source BRD/PRD documents — kept locally, never committed (this repo is public)
/DatIQ *.md
/DatIQ *.pdf

# Local deployment stack (doc 06): generated config + real env files + dumps
deployment/generated/
deployment/env/.env.local
deployment/env/.env.staging
deployment/env/.env.prod
deployment/generated/*.dump
