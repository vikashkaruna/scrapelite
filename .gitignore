node_modules
dist
dist-ssr
*.local
.DS_Store

# Local env — never commit real secrets
.env
.env.*
!.env.example

# Editor
.vscode/*
!.vscode/extensions.json
.idea

# Setup script output — may contain generated IDs but no secrets
# scripts/migrations.sql is safe to commit; setup-providers.sh reads .env so it's fine too

# Local Netlify folder
.netlify

# E2E test screenshots — generated on demand, not committed
e2e-screenshots/*.png

# Test artifacts — generated by `npm run test:all` and friends, never
# committed. Re-runnable from clean state.
coverage/
test-results/
playwright-report/
playwright/.cache/

