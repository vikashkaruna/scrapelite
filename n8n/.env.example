# n8n/.env.example
#
# Copy to .env on the host and fill in real values. .env is gitignored.
# All values are server-side only (no VITE_ prefix). Netlify env vars
# for DatIQ are documented in netlify.toml + CLAUDE.md.
#
# ── Required ─────────────────────────────────────────────────────────────

# Public URL of this n8n instance. Used in workflow email links back
# to DatIQ. For Hostinger: your assigned URL or your custom domain
# (e.g. https://n8n.datiq.app).
WEBHOOK_URL=https://n8n-k8q6.srv1738397.hstgr.cloud

# Timezone for cron schedules in n8n workflows.
GENERIC_TIMEZONE=Asia/Kolkata

# 32 random bytes (base64 or hex). Encrypts stored credentials in
# the n8n database. KEEP THIS SAFE — losing it locks you out of
# every credential stored in n8n. Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace-me-with-openssl-rand-hex-32

# Shared secret for the orchestrator + DatIQ → n8n auth. Same value
# must be set in Netlify env as N8N_WEBHOOK_SECRET. The orchestrator
# sends Authorization: Bearer <DATIQ_N8N_API_KEY> to the workflow
# webhook endpoints. Generate: openssl rand -hex 32
DATIQ_N8N_API_KEY=replace-me-with-openssl-rand-hex-32


# ── UI auth ──────────────────────────────────────────────────────────────
# Choice A: n8n's built-in user accounts (recommended for V1 — your pick)
#   Set N8N_USER_MANAGEMENT_DISABLED=false (or omit) and create the
#   first owner from the UI. Skip the N8N_BASIC_AUTH_* lines.
#
# Choice B: HTTP basic auth in front of n8n (simpler for solo)
#   Set N8N_USER_MANAGEMENT_DISABLED=true and fill in user/password.
#
# V2 plan: docs/WORKFLOW-IMPLEMENTATION-PLAN.md §4.4. User picked
# "n8n built-in user accounts" so Choice A is the default.

N8N_USER_MANAGEMENT_DISABLED=false


# ── n8n queue / exec ─────────────────────────────────────────────────────
# EXECUTIONS_DATA_PRUNE=true + the next two keep the SQLite DB small.
# 7-day window is enough for debugging; bump to 30 if you need history.
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=true

# Queue mode is off in V1 (single process); turn on when you migrate
# to Postgres and need the worker process.
EXECUTIONS_MODE=regular
N8N_QUEUE_HEALTH_CHECK_ACTIVE=false


# ── MCP server endpoint ──────────────────────────────────────────────────
# n8n's MCP Server Trigger listens on /mcp/<path>. The path is set
# per-workflow in the n8n UI. Set the public base here so workflows
# can include absolute URLs in responses.
N8N_MCP_ENABLED=true


# ── Optional ─────────────────────────────────────────────────────────────

# Log level (info, debug, warn, error). Default info.
N8N_LOG_LEVEL=info

# Set to "true" to log every execution to stdout (verbose).
N8N_LOG_OUTPUT=console

# Disable telemetry to n8n's servers (privacy + perf).
N8N_TELEMETRY_DISABLED=true

# Allow HEAD/OPTIONS/GET on the webhook endpoints (useful for
# health-check pings from DatIQ).
N8N_WEBHOOK_ALLOW_HTTP_GET=true


# ── Netlify-side mirror ─────────────────────────────────────────────────
# These are NOT used by n8n — they document the env vars that must be
# set in Netlify (Site → Settings → Environment) for the orchestrator
# function to find this n8n instance.
#
# N8N_BASE_URL        = same as WEBHOOK_URL above
# N8N_WEBHOOK_SECRET  = same as DATIQ_N8N_API_KEY above
# WORKFLOW_ORCHESTRATOR_TOKEN = separate random secret; the orchestrator's
#                               manual HTTP trigger requires this Bearer token.
#                               Generate: openssl rand -hex 32
