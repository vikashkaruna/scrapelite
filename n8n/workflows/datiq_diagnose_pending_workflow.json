{
  "name": "datiq_diagnose_pending_workflow",
  "nodes": [
    {
      "parameters": {
        "toolName": "datiq_diagnose_pending_workflow",
        "toolDescription": "Diagnostic tool. Given a workflow event id, fetches the event + recent attempts + the target schedule + the user + recent extractions, and returns a structured diagnostic. Use this when 'why did this fail?'.",
        "toolInputSchema": {
          "type": "object",
          "properties": {
            "event_id": {
              "type": "string"
            }
          },
          "required": [
            "event_id"
          ]
        }
      },
      "type": "@n8n/n8n-nodes-langchain.mcpTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "id": "00000000-0000-4000-a88a-3f448d4fde00",
      "name": "MCP Trigger"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://' + $json._ctx.supabase_url + ('/rest/v1/workflow_events?id=eq.' + $json.event_id + '&select=*') }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $credentials['datiq-supabase-service'].value }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $credentials['datiq-supabase-service'].value }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        300
      ],
      "id": "00000000-0000-4000-a89d-dcce140e6680",
      "name": "Fetch event"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}"
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        760,
        300
      ],
      "id": "00000000-0000-4000-a5e3-e92ff2576ec0",
      "name": "Respond"
    }
  ],
  "connections": {
    "MCP Trigger": {
      "main": [
        [
          {
            "node": "Fetch event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch event": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
