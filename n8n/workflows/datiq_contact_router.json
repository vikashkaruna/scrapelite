{
  "name": "datiq_contact_router",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "datiq/contact-router",
        "responseMode": "responseNode",
        "authentication": "headerAuth",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "id": "00000000-0000-4000-a2d8-a61ceb384c40",
      "name": "Webhook"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "channel": "=#datiq-support",
        "text": "=:envelope: New contact: *{{ $json.type }}* from {{ $json.from }}\n>{{ $json.subject }}\n>{{ ($json.body || '').slice(0, 200) }}"
      },
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "id": "00000000-0000-4000-a626-ff7ea86f1cc0",
      "name": "Notify Slack",
      "credentials": {
        "slackOAuth2Api": {
          "id": "datiq-slack-monitoring",
          "name": "datiq-slack-monitoring"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VITE_CONTACT_WEBHOOK_URL || $env.VITE_WEBHOOK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "continueOnFail": true
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        740,
        300
      ],
      "id": "00000000-0000-4000-a193-d57313964660",
      "name": "Forward to CRM"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json._ctx?.callback_url || ($json._ctx?.site_url ? 'https://' + $json._ctx.site_url + '/api/workflow-callback' : $env.SITE_URL + '/api/workflow-callback') }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.DATIQ_N8N_API_KEY || $env.N8N_WEBHOOK_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\\n  \"event_id\": \"{{ $json.id }}\",\\n  \"state\": \"done\",\\n  \"output\": { \"completed_at\": \"{{ $now.toISO() }}\" }\\n}",
        "options": {
          "continueOnFail": true
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        980,
        300
      ],
      "id": "00000000-0000-4000-a830-4b221324a700",
      "name": "Callback DatIQ"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true }) }}"
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1220,
        300
      ],
      "id": "00000000-0000-4000-a15f-47d0e0fe81b0",
      "name": "Respond OK"
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Notify Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify Slack": {
      "main": [
        [
          {
            "node": "Forward to CRM",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Forward to CRM": {
      "main": [
        [
          {
            "node": "Callback DatIQ",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Callback DatIQ": {
      "main": [
        [
          {
            "node": "Respond OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": true,
    "saveManualExecutions": true,
    "errorWorkflow": "00000000-0000-4000-a887-6b7af3ce4d00"
  },
  "versionId": "00000000-0000-4000-a0e8-1f2f9d454690",
  "id": "00000000-0000-4000-a56c-177b693c4740",
