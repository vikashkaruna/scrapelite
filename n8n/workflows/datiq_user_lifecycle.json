        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"from\": \"{{ $env.CONTACT_EMAIL_FROM || 'DatIQ <hello@datiq.app>' }}\",\n  \"to\": [\"{{ $json.user?.email }}\"],\n  \"subject\": \"{{ $json.subject || 'Welcome to DatIQ' }}\",\n  \"html\": \"{{ $json.html || '<p>Welcome to DatIQ!</p>' }}\"\n}",
        "options": {
          "continueOnFail": true
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        300
      ],
      "id": "00000000-0000-4000-a22d-6cfda6f31280",
      "name": "Send Resend email"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ 'https://' + $json._ctx.supabase_url + ('/rest/v1/workflow_events?id=eq.' + $json.id) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $credentials['datiq-supabase-service'].value }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $credentials['datiq-supabase-service'].value }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"state\": \"done\", \"finished_at\": \"={{ $now.toISO() }}\", \"last_error\": null }",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
