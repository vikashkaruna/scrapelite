{
  "name": "datiq_cancel_workflow_event",
  "nodes": [
    {
      "parameters": {
        "toolName": "datiq_cancel_workflow_event",
        "toolDescription": "Mark a workflow event as cancelled so the orchestrator won't retry it. The event stays in the table for audit; it just won't run again.",
        "toolInputSchema": {
          "type": "object",
          "properties": {
            "event_id": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "event_id"
          ]
        }
      },
      "type": "@n8n/n8n-nodes-langchain.mcpTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "id": "00000000-0000-4000-a270-1127f4619960",
      "name": "MCP Trigger"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ 'https://' + $json._ctx.supabase_url + ('/rest/v1/workflow_events?id=eq.' + $json.event_id) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $credentials['datiq-supabase-service'].value }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $credentials['datiq-supabase-service'].value }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"state\": \"cancelled\", \"finished_at\": \"={{ $now.toISO() }}\", \"last_error\": \"={{ $json.reason || \\\"cancelled by operator\\\" }}\" }",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        300
      ],
      "id": "00000000-0000-4000-a294-55129dd802c0",
      "name": "Cancel"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}"
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        760,
        300
      ],
      "id": "00000000-0000-4000-a4d3-37a8f127e340",
      "name": "Respond"
    }
  ],
  "connections": {
    "MCP Trigger": {
      "main": [
        [
          {
            "node": "Cancel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cancel": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": true,
    "saveManualExecutions": true,
    "errorWorkflow": "00000000-0000-4000-a887-6b7af3ce4d00"
  },
  "versionId": "00000000-0000-4000-a48f-f47c38cb27c0",
  "id": "00000000-0000-4000-a507-dd10d419e380",
  "meta": {
    "templateCredsSetupCompleted": false,
    "description": ""
  }
}
