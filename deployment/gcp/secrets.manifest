# deployment/gcp/secrets.manifest — which runtime env vars become Secret
# Manager secrets, which operator file keys supply their values, and which
# services mount them. NAMES ONLY (doc 06): this file never holds values.
#
#   <runtime-env-var>  <key-in-operator-env-file>  <services: informational>
#
# The services column is DOCUMENTATION ONLY: deploy-run.sh mounts every existing
# secret on BOTH api and jobs (the scheduler-run jobs share the runtime set —
# see the JOBS_SECRETS assignment there).
#
# Values come from deployment/env/.env.<env> (gitignored) — the ONLY source.
# The legacy scripts/env/<env>.env is ignored (it once pushed stale Razorpay
# keys); RUNTIME_ENV_FILE=<path> is an explicit opt-in override. A manifest row
# whose source key is absent or EMPTY in that file is skipped — e.g. STRIPE_* while
# Stripe is deferred. Secret resource names are composed at runtime:
#   datiq-<DATIQ_PROJECT_CODE>-sm-<lowercased-runtime-var>-<env-suffix>
#
SUPABASE_SERVICE_KEY      SUPABASE_SERVICE_KEY                  api jobs
FIRECRAWL_API_KEY         FIRECRAWL_API_KEY                     api jobs
ANTHROPIC_API_KEY         ANTHROPIC_API_KEY                     api
AI_API_KEY                AI_API_KEY                            api
GEMINI_API_KEY            GEMINI_API_KEY                        api
OPENAI_API_KEY            OPENAI_API_KEY                        api
JINA_API_KEY              JINA_API_KEY                          api
SPIDER_API_KEY            SPIDER_API_KEY                        api
RESEND_API_KEY            RESEND_API_KEY                        api
RAZORPAY_KEY_ID           RAZORPAY_KEY_ID                       api
RAZORPAY_KEY_SECRET       RAZORPAY_KEY_SECRET                   api
RAZORPAY_WEBHOOK_SECRET   RAZORPAY_WEBHOOK_SECRET               api
STRIPE_SECRET_KEY         STRIPE_SECRET_KEY                     api
STRIPE_WEBHOOK_SECRET     STRIPE_WEBHOOK_SECRET                 api
ADMIN_PIN                 ADMIN_PIN                             api
ADMIN_PIN_HASH            ADMIN_PIN_HASH                        api
ADMIN_TOKEN_SECRET        ADMIN_TOKEN_SECRET                    api
N8N_WEBHOOK_SECRET        N8N_WEBHOOK_SECRET                    api
N8N_BASE_URL              N8N_BASE_URL                          api
DATIQ_N8N_API_KEY         DATIQ_N8N_API_KEY                     api
WORKFLOW_ORCHESTRATOR_TOKEN WORKFLOW_ORCHESTRATOR_TOKEN         api
SLACK_WEBHOOK_URL         SLACK_WEBHOOK_URL                     api
GUEST_ID_SALT             GUEST_ID_SALT                         api
PAGESPEED_API_KEY         PAGESPEED_API_KEY                     api jobs
PERPLEXITY_API_KEY        PERPLEXITY_API_KEY                    api jobs
ENGAGEMENT_RESEND_WEBHOOK_SECRET ENGAGEMENT_RESEND_WEBHOOK_SECRET api
ENGAGEMENT_RESEND_API_KEY ENGAGEMENT_RESEND_API_KEY             api jobs
ENGAGEMENT_UNSUBSCRIBE_SECRET ENGAGEMENT_UNSUBSCRIBE_SECRET     api jobs
JOBS_TOKEN                JOBS_TOKEN                            jobs
INTEGRATION_SECRETS_KEY   INTEGRATION_SECRETS_KEY              api jobs
