# ══════════════════════════════════════════════════════════════════════════════
# DatIQ PRODUCTION (GCP) — copy to deployment/env/.env.prod and fill.
#
#   HOW TO OBTAIN: `cp deployment/env/.env.prod.example deployment/env/.env.prod`.
#   Phase 1c scaffolding (doc 06): fill real values ONLY at the cutover rehearsal
#   — nothing here is deployed yet. Phase 1b (prod shadow) uses the first two
#   sections; the rest becomes live only when the cutover runbook is followed.
#
#   Contract (doc 06): operators edit ONLY this file; every script reads from it.
#   Comments MUST sit on their own lines above the value — inline `# trailing
#   comments` on value lines are NOT parsed away by the deploy tooling.
#   Every variable is documented as: [purpose] · [how to obtain] · DO / DON'T.
#
#   Doc 06: docs/plans/gcp-docker-migration/06-NAMING-AND-ENV-CONVENTIONS.md
# ══════════════════════════════════════════════════════════════════════════════

# ── 1. GCP core ──────────────────────────────────────────────────────────────
# The GCP project that owns ALL production resources. HOW TO OBTAIN: gcloud
# projects list. DO: the same project as staging (separate -prod names).
GCP_PROJECT_ID=vikash-saas-project
# Deploy region — DO: keep it identical to staging (asia-south1) so the
# digest-promotion path and cutover runbook work verbatim.
GCP_REGION=asia-south1
# Project code segment in every resource name (datiq-<code>-...).
DATIQ_PROJECT_CODE=vsp
# Environment identity (production). Used by the loader for .env.<env> resolution.
DATIQ_ENV=production
# Resource-name suffix. DO: keep the doc-06 default -prod.
DATIQ_ENV_SUFFIX=-prod
DATIQ_OWNER_LABEL=vikash
# GCP billing account — HOW TO OBTAIN: gcloud billing accounts list.
GCP_BILLING_ACCOUNT_ID=REPLACE_ME

# ── 2. Resource names (doc 06 defaults) ──────────────────────────────────────
# Same convention as staging with the -prod suffix. DO: create these ONLY via
# bootstrap.sh prod (it also creates the deploy/service-account bindings).
CLOUD_RUN_API=datiq-vsp-run-api-prod
CLOUD_RUN_JOBS=datiq-vsp-run-jobs-prod
CLOUD_RUN_AUTH=datiq-vsp-run-auth-prod
CLOUD_RUN_REST=datiq-vsp-run-rest-prod
CLOUD_RUN_ADMIN=datiq-vsp-run-admin-prod
CLOUD_RUN_TRACKERS=datiq-vsp-run-trackers-prod
AR_REPO=datiq-vsp-ar-images-prod
SQL_INSTANCE=datiq-vsp-sql-datiq-prod
SA_DEPLOY=datiq-vsp-sa-deploy
SA_API=datiq-vsp-sa-api-prod
SA_JOBS=datiq-vsp-sa-jobs-prod
SA_SCHEDULER=datiq-vsp-sa-scheduler-prod
ARTIFACTS_BUCKET=datiq-vsp-gcs-artifacts-prod
FHS_SITE_ID=datiq-vsp-fhs-prod
FB_WEB_APP_DISPLAY=DatIQ-vsp-fb-production-web

# ── 3. URLs — the shadow URL first; datiq.app only at cutover ────────────────
# APP_BASE_URL is what the functions believe their origin is. During the shadow
# phase keep it the shadow URL (post-cutover you flip it to datiq.app).
APP_BASE_URL=https://datiq-vsp-fhs-prod.web.app
# The production-twin ("shadow") URL — what operators/CI test before the flip.
SHADOW_BASE_URL=https://datiq-vsp-fhs-prod.web.app
API_BASE_URL=${APP_BASE_URL}
# The post-cutover production origin (used in runbook checks; not read by scripts).
# DATIQ_APP_CANONICAL=https://datiq.app

# ── 4. Images (promote the staging-validated digest — no rebuild) ────────────
# Registry base composed from region/project/repo. DO: never hand-edit.
IMG_BASE=${GCP_REGION}-docker.pkg.dev/${GCP_PROJECT_ID}/${AR_REPO}
# promote-prod.sh overwrites IMG_API/IMG_ADMIN/IMG_TRACKERS with the digests it
# resolves (see §12); this value is the manual fallback path.
IMG_TAG=REPLACE_ME_promoted_digest
IMG_API=${IMG_BASE}/datiq-vsp-ctr-api:${IMG_TAG}

# ── 5. Database (prod sizing + protection) ───────────────────────────────────
# All three protection knobs are consumed by migrate-db.sh at instance creation
# (availability-type, PITR, connectivity warning). DO: verify they were applied
# after creation: gcloud sql instances describe <instance> --format='value(settings.availabilityType)'.
DB_NAME=datiq
DB_APP_USER=datiq_app
# Password for DB_APP_USER. HOW TO OBTAIN: `openssl rand -hex 24` (or a vault). SECRET.
DB_APP_PASSWORD=REPLACE_ME
# Machine tier for production traffic. DO: db-custom-2-7680 or larger per load.
CLOUD_SQL_TIER=db-custom-2-7680
# Enterprise edition (required for HA/PITR options).
CLOUD_SQL_EDITION=ENTERPRISE
# High availability: REGIONAL = failover replica. DO: REGIONAL for prod.
CLOUD_SQL_HA=REGIONAL
# 1 = point-in-time recovery enabled. DO: 1 for prod (extra storage cost).
CLOUD_SQL_BACKUP_PITR=1
# private = only private-IP access (requires VPC + private-services-access
# configured FIRST). migrate-db.sh warns and does NOT automate it.
# DO: configure the network BEFORE the cutover rehearsal; DON'T: set private
# the day of the cutover.
CLOUD_SQL_CONNECTIVITY=private
# Daily backup window start (HH:MM UTC).
CLOUD_SQL_BACKUP_START=09:00
CLOUD_SQL_PROXY_PORT=15432
# 1 = destructive purge jobs may run. DO: explicit decision, never a default.
PURGE_ENABLED=REPLACE_ME_explicit_decision

# ── 6. Data mode (hosted Supabase during shadow → Cloud SQL at cutover) ──────
# hosted-supabase while the shadow runs against the hosted PROD project;
# cutover-db.sh persists cloud-sql here at the cutover.
DATA_MODE=hosted-supabase
# The PROD Supabase project URL. HOW TO OBTAIN: Supabase dashboard → Settings →
# API → Project URL. NOTE: sikkfxysjhirmtwkumpt is the prod project ref.
SUPABASE_URL=REPLACE_ME_PROD_PROJECT_URL
# PROD anon key (public by design).
SUPABASE_ANON_KEY=REPLACE_ME
# PROD service_role key — SECRET: server-side only, never in any browser bundle.
SUPABASE_SERVICE_KEY=REPLACE_ME
# JWT_SECRET — at the cutover this MUST be the PROD Supabase JWT secret (same
# secret keeps all existing sessions valid across the flip). HOW TO OBTAIN:
# Supabase dashboard → Settings → API → JWT Secret. DO: set it BEFORE running
# cutover-db.sh. DON'T: generate a fresh one — that logs every user out.
# JWT_SECRET=REPLACE_ME_PROD_SUPABASE_JWT_SECRET

# ── 7. Upstream proof-service images (mirrored into Artifact Registry) ───────
# The SAME staged images the staging env verified (stage-third-party.yaml) —
# promoted by digest, not rebuilt. DO: promote exactly what staging ran.
AUTH_IMAGE=REPLACE_ME_staged_gotrue_image
REST_IMAGE=REPLACE_ME_staged_postgrest_image

# ── 8. Platform-env emulation ────────────────────────────────────────────────
# Netlify CONTEXT emulation: production = full production behaviour.
APP_CONTEXT=production
# Netlify BRANCH emulation: main.
GIT_BRANCH=main

# ── 9. Runtime feature knobs ─────────────────────────────────────────────────
# 1 = GCP does NOT own crons (Netlify prod keeps them) during the shadow — flip
# to 0 ONLY when the Netlify TOML schedules are commented (never both, doc 05 §3b).
OPS_JOBS_DISABLED=1
ENGAGEMENT_ENABLED=REPLACE_ME
# Hour the @daily Cloud Scheduler jobs fire.
DAILY_HOUR_UTC=3
SITE_NAME=DatIQ
SCRAPE_PROVIDER_ORDER=direct,spider,jina
VITE_AI_MODEL=REPLACE_ME
# n8n webhook — PRODUCTION workflow URL (/webhook/, activated + CORS), NOT the
# test URL. HOW TO OBTAIN: n8n dashboard → workflow → webhook → production URL.
VITE_WEBHOOK_URL=https://vkaruna.app.n8n.cloud/webhook/datiq
N8N_PUBLIC_WEBHOOK_URL=https://vkaruna.app.n8n.cloud/webhook/datiq

# ── 10. Frontend/tracker layer (production values) ───────────────────────────
# NOTE (current state): the GCP serving path is the COMMITTED
# public/runtime-config.js, which host-branches PostHog/GA PROD-only (PR #241)
# — these keys document the production values and become env-driven when the
# tracker layer switches to deploy-time rendering. Fill with the real values at
# cutover so the contract is complete.
GA_MEASUREMENT_ID=G-B0DZLRWG63
# PostHog project key — HOW TO OBTAIN: PostHog dashboard → Project Settings.
POSTHOG_KEY=REPLACE_ME
POSTHOG_HOST=https://us.i.posthog.com
CONSENT_POLICY_VERSION=2026-08-15
# Razorpay LIVE publishable checkout key. HOW TO OBTAIN: Razorpay dashboard →
# Settings → API Keys (rzp_live_...). Safe for the browser; the SECRET goes to
# Secret Manager only, never here.
VITE_RAZORPAY_KEY_ID=REPLACE_ME

# ── 11. Deploy/test hooks ────────────────────────────────────────────────────
# Playwright base URL: shadow during the parallel run, datiq.app post-cutover.
PW_BASE_URL=${SHADOW_BASE_URL}
# The URL smoke.sh curls: APP_BASE_URL (shadow) until the DNS flip.
SMOKE_TARGET=${APP_BASE_URL}
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=REPLACE_ME
# Shared secret for Cloud Scheduler → jobs service. HOW TO OBTAIN: `openssl rand
# -hex 24`; bootstrap-secrets.sh pushes it to Secret Manager. SECRET.
JOBS_TOKEN=REPLACE_ME
# Alert recipient used by the monitoring jobs. DO: a real operator inbox.
OPS_ALERT_EMAIL=REPLACE_ME

# ── 12. Staging coordinates for digest promotion (promote-prod.sh) ───────────
# promote-prod.sh prod (DIGESTS_FROM=staging, the default) resolves the
# staging-validated image digests from the STAGING project's registry and
# promotes them without rebuilding. HOW TO OBTAIN: copy the staging env values
# (gcloud artifacts docker images list on the staging repo gives the tag list).
STAGING_GCP_PROJECT_ID=vikash-saas-project
STAGING_GCP_REGION=asia-south1
STAGING_AR_REPO=datiq-vsp-ar-images-stg
# The staging image tag to promote (the git SHA staging was deployed from —
# build-images.sh tags images with the commit SHA, never `:staging`).
STAGING_IMG_TAG=REPLACE_ME_staging_git_sha
