# ══════════════════════════════════════════════════════════════════════════════
# DatIQ PRODUCTION (GCP) — copy to deployment/env/.env.prod and fill.
#
#   HOW TO OBTAIN: `cp deployment/env/.env.prod.example deployment/env/.env.prod`.
#   Phase 1c scaffolding (doc 06): fill real values ONLY at the cutover rehearsal
#   — nothing here is deployed yet. Phase 1b (prod shadow) uses the first two
#   sections; the rest becomes live only when the cutover runbook is followed.
#
#   Contract (doc 06): operators edit ONLY this file; every script reads from it.
#   Comments MUST sit on their own lines above the value — inline `# trailing
#   comments` on value lines are NOT parsed away by the deploy tooling.
#   Every variable is documented as: [purpose] · [how to obtain] · DO / DON'T.
#
#   Doc 06: docs/plans/gcp-docker-migration/06-NAMING-AND-ENV-CONVENTIONS.md
# ══════════════════════════════════════════════════════════════════════════════

# ── 1. GCP core ──────────────────────────────────────────────────────────────
# The GCP project that owns ALL production resources. HOW TO OBTAIN: gcloud
# projects list. DO: the same project as staging (separate -prod names).
GCP_PROJECT_ID=vikash-saas-project
# Deploy region — DO: keep it identical to staging (asia-south1) so the
# digest-promotion path and cutover runbook work verbatim.
GCP_REGION=asia-south1
# Project code segment in every resource name (datiq-<code>-...).
DATIQ_PROJECT_CODE=vsp
# Environment identity (production). Used by the loader for .env.<env> resolution.
DATIQ_ENV=production
# Resource-name suffix. DO: keep the doc-06 default -prod.
DATIQ_ENV_SUFFIX=-prod
DATIQ_OWNER_LABEL=vikash
# GCP billing account — HOW TO OBTAIN: gcloud billing accounts list.
GCP_BILLING_ACCOUNT_ID=REPLACE_ME

# ── 2. Resource names (doc 06 defaults) ──────────────────────────────────────
# Same convention as staging with the -prod suffix. DO: create these ONLY via
# bootstrap.sh prod (it also creates the deploy/service-account bindings).
CLOUD_RUN_API=datiq-vsp-run-api-prod
CLOUD_RUN_JOBS=datiq-vsp-run-jobs-prod
CLOUD_RUN_AUTH=datiq-vsp-run-auth-prod
CLOUD_RUN_REST=datiq-vsp-run-rest-prod
CLOUD_RUN_ADMIN=datiq-vsp-run-admin-prod
CLOUD_RUN_TRACKERS=datiq-vsp-run-trackers-prod
# Cloud Run service for private Supabase Studio connected to Cloud SQL.
# HOW TO OBTAIN: Doc 06 naming convention datiq-<code>-run-studio-<suffix>.
# DO: Keep private (--no-allow-unauthenticated). DON'T: expose publicly without IAP.
CLOUD_RUN_STUDIO=datiq-vsp-run-studio-prod
# Local host port used by proxy-studio.sh to access private Cloud Run Studio.
# HOW TO OBTAIN: Choose an unused local port (default 54328 matches local studio port).
# DO: Parameterise per operator workstation. DON'T: conflict with local DB (54329).
STUDIO_HOST_PORT=54328
# Container port Supabase Studio listens on inside Cloud Run (Next.js default 3000).
# HOW TO OBTAIN: Upstream studio default container port.
# DO: Keep 3000. DON'T: change unless custom studio build requires different port.
STUDIO_PORT=3000
AR_REPO=datiq-vsp-ar-images-prod
SQL_INSTANCE=datiq-vsp-sql-datiq-prod
SA_DEPLOY=datiq-vsp-sa-deploy
SA_API=datiq-vsp-sa-api-prod
SA_JOBS=datiq-vsp-sa-jobs-prod
SA_SCHEDULER=datiq-vsp-sa-scheduler-prod
ARTIFACTS_BUCKET=datiq-vsp-gcs-artifacts-prod
FHS_SITE_ID=datiq-vsp-fhs-prod
FB_WEB_APP_DISPLAY=DatIQ-vsp-fb-production-web

# ── 3. URLs — the shadow URL first; datiq.app only at cutover ────────────────
# APP_BASE_URL is what the functions believe their origin is. During the shadow
# phase keep it the shadow URL (post-cutover you flip it to datiq.app).
APP_BASE_URL=https://datiq-vsp-fhs-prod.web.app
# The production-twin ("shadow") URL — what operators/CI test before the flip.
SHADOW_BASE_URL=https://datiq-vsp-fhs-prod.web.app
API_BASE_URL=${APP_BASE_URL}
# The post-cutover production origin (used in runbook checks; not read by scripts).
# DATIQ_APP_CANONICAL=https://datiq.app

# ── 4. Images (promote the staging-validated digest — no rebuild) ────────────
# Registry base composed from region/project/repo. DO: never hand-edit.
IMG_BASE=${GCP_REGION}-docker.pkg.dev/${GCP_PROJECT_ID}/${AR_REPO}
# promote-prod.sh overwrites IMG_API/IMG_ADMIN/IMG_TRACKERS with the digests it
# resolves (see §12); this value is the manual fallback path.
IMG_TAG=REPLACE_ME_promoted_digest
IMG_API=${IMG_BASE}/datiq-vsp-ctr-api:${IMG_TAG}

# ── 5. Database (prod sizing + protection) ───────────────────────────────────
# All three protection knobs are consumed by migrate-db.sh at instance creation
# (availability-type, PITR, connectivity warning). DO: verify they were applied
# after creation: gcloud sql instances describe <instance> --format='value(settings.availabilityType)'.
DB_NAME=datiq
DB_APP_USER=datiq_app
# Password for DB_APP_USER. HOW TO OBTAIN: `openssl rand -hex 24` (or a vault). SECRET.
DB_APP_PASSWORD=REPLACE_ME
# Machine tier — applied ONLY when the instance is CREATED (later edits need
# `gcloud sql instances patch --tier`). DO: db-custom-2-7680 or larger for real
# traffic; db-g1-small is shared-core (no SLA) and fine while there are no users.
CLOUD_SQL_TIER=db-custom-2-7680
# Postgres major version, applied at creation only. Upgrade in place with
# `gcloud sql instances patch <inst> --database-version=POSTGRES_17`.
CLOUD_SQL_DB_VERSION=POSTGRES_17
# Enterprise edition (required for HA/PITR options).
CLOUD_SQL_EDITION=ENTERPRISE
# High availability: REGIONAL = failover replica. DO: REGIONAL for prod.
CLOUD_SQL_HA=REGIONAL
# 1 = point-in-time recovery enabled. DO: 1 for prod (extra storage cost).
CLOUD_SQL_BACKUP_PITR=1
# private = only private-IP access (requires VPC + private-services-access
# configured FIRST). migrate-db.sh warns and does NOT automate it.
# DO: configure the network BEFORE the cutover rehearsal; DON'T: set private
# the day of the cutover.
CLOUD_SQL_CONNECTIVITY=private
# Daily backup window start (HH:MM UTC).
CLOUD_SQL_BACKUP_START=09:00
CLOUD_SQL_PROXY_PORT=15432
# 1 = destructive purge jobs may run. DO: explicit decision, never a default.
PURGE_ENABLED=REPLACE_ME_explicit_decision

# ── 6. Data mode (hosted Supabase during shadow → Cloud SQL at cutover) ──────
# hosted-supabase while the shadow runs against the hosted PROD project;
# cutover-db.sh persists cloud-sql here at the cutover.
DATA_MODE=hosted-supabase
# The PROD Supabase project URL. HOW TO OBTAIN: Supabase dashboard → Settings →
# API → Project URL. NOTE: sikkfxysjhirmtwkumpt is the prod project ref.
SUPABASE_URL=REPLACE_ME_PROD_PROJECT_URL
# PROD anon key (public by design).
SUPABASE_ANON_KEY=REPLACE_ME
# PROD service_role key — SECRET: server-side only, never in any browser bundle.
SUPABASE_SERVICE_KEY=REPLACE_ME
# JWT_SECRET — at the cutover this MUST be the PROD Supabase JWT secret (same
# secret keeps all existing sessions valid across the flip). HOW TO OBTAIN:
# Supabase dashboard → Settings → API → JWT Secret. DO: set it BEFORE running
# cutover-db.sh. DON'T: generate a fresh one — that logs every user out.
# JWT_SECRET=REPLACE_ME_PROD_SUPABASE_JWT_SECRET
# Auto-confirm user email on GoTrue signup.
# HOW TO OBTAIN: "false" in production (requires email confirmation before signin).
# DO: keep false in production. DON'T: set true in production.
GOTRUE_MAILER_AUTOCONFIRM=false

# ── Transactional email via Resend SMTP (self-hosted GoTrue) ─────────────────
# Hosted Supabase sent signup-confirm / password-reset / magic-link mail itself;
# self-hosted GoTrue only sends when this block is set. Applied by
# `deploy-run.sh prod auth`. The password is NOT put here: bootstrap-secrets.sh
# pushes GOTRUE_SMTP_PASS (below) — or, if empty, RESEND_API_KEY — to Secret
# Manager and mounts it on the auth service. Resend: user is literally "resend",
# the password is an API key; ADMIN_EMAIL must be on a domain verified in Resend.
GOTRUE_SMTP_HOST=smtp.resend.com
GOTRUE_SMTP_PORT=465
GOTRUE_SMTP_USER=resend
GOTRUE_SMTP_ADMIN_EMAIL=hello@datiq.app
GOTRUE_SMTP_SENDER_NAME=DatIQ
GOTRUE_SMTP_PASS=

# ── 7. Upstream proof-service images (mirrored into Artifact Registry) ───────
# The SAME staged images the staging env verified (stage-third-party.yaml) —
# promoted by digest, not rebuilt. DO: promote exactly what staging ran.
AUTH_IMAGE=REPLACE_ME_staged_gotrue_image
REST_IMAGE=REPLACE_ME_staged_postgrest_image
# The SAME staged studio image the staging env verified (stage-studio.sh).
# HOW TO OBTAIN: Promote from staging repository via promote-prod.sh.
# DO: Keep private. DON'T: expose publicly.
STUDIO_IMAGE=REPLACE_ME_staged_studio_image
# The SAME staged postgres-meta image the staging env verified (stage-studio.sh).
# HOW TO OBTAIN: Promote from staging repository via promote-prod.sh.
# DO: Keep private. DON'T: expose publicly.
PG_META_IMAGE=REPLACE_ME_staged_pg_meta_image

# ── 8. Platform-env emulation ────────────────────────────────────────────────
# Netlify CONTEXT emulation: production = full production behaviour.
APP_CONTEXT=production
# Netlify BRANCH emulation: main.
GIT_BRANCH=main

# ── 9. Runtime feature knobs ─────────────────────────────────────────────────
# 1 = GCP does NOT own crons (Netlify prod keeps them) during the shadow — flip
# to 0 ONLY when the Netlify TOML schedules are commented (never both, doc 05 §3b).
OPS_JOBS_DISABLED=1
# Hour the @daily Cloud Scheduler jobs fire.
DAILY_HOUR_UTC=3
SITE_NAME=DatIQ
SCRAPE_PROVIDER_ORDER=direct,spider,jina
VITE_AI_MODEL=REPLACE_ME
# Anthropic sk-ant-... (console.anthropic.com → API Keys) — preferred key name for Anthropic.
# HOW TO OBTAIN: console.anthropic.com → API Keys.
# DO: keep server-side only. DON'T: prefix with VITE_.
ANTHROPIC_API_KEY=REPLACE_ME
# Google AI Studio key
# HOW TO OBTAIN: aistudio.google.com/apikey.
# DO: keep server-side only. DON'T: prefix with VITE_.
GEMINI_API_KEY=REPLACE_ME
# Gemini model override for fast tier (classification, tagging, short extractions).
# HOW TO OBTAIN: valid model from Google AI Studio (gemini-3.8-flash, gemini-flash-latest).
# DO: use active non-retired model IDs. DON'T: use retired 2.x models.
GEMINI_MODEL_FAST=gemini-3.8-flash
# Gemini model override for deep tier (reports, synthesis, complex extractions).
# HOW TO OBTAIN: valid model from Google AI Studio (gemini-pro-latest).
# DO: use active non-retired model IDs. DON'T: use retired 2.x models.
GEMINI_MODEL_DEEP=gemini-pro-latest
# OpenAI model override for fast tier (classification, tagging, short jobs).
# HOW TO OBTAIN: platform.openai.com → models (gpt-6-luna, gpt-6-sol).
# DO: use active model IDs. DON'T: pin a retired generation.
OPENAI_MODEL_FAST=gpt-6-luna
# OpenAI model override for deep tier (extraction, enrichment, synthesis).
# HOW TO OBTAIN: platform.openai.com → models.
# DO: same id as _FAST is fine (Luna covers both tiers). DON'T: leave stale pins.
OPENAI_MODEL_DEEP=gpt-6-luna
# Anthropic model override for fast tier (high-speed execution).
# HOW TO OBTAIN: docs.anthropic.com → models (claude-haiku-4-5-20251001).
# DO: keep server-side. DON'T: prefix with VITE_.
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
# Anthropic model override for deep tier (everyday professional work:
# discoverability, workflow templates).
# HOW TO OBTAIN: docs.anthropic.com → models (claude-sonnet-5).
ANTHROPIC_MODEL_DEEP=claude-sonnet-5
# Perplexity model overrides (answer-engine citation sampling).
# HOW TO OBTAIN: docs.perplexity.ai (sonar, sonar-pro).
PERPLEXITY_MODEL_FAST=sonar
PERPLEXITY_MODEL_DEEP=sonar-pro
# Global AI provider fallback order (comma-separated provider ids). Empty =
# code default: openai,gemini,anthropic (owner-set 2026-09-30). /admin/ai can
# re-order globally and per-area at runtime without a deploy.
# DO: keep all three present so a dead provider degrades, never drops.
AI_PROVIDER_ORDER=
# n8n webhook — PRODUCTION workflow URL (/webhook/, activated + CORS), NOT the
# test URL. HOW TO OBTAIN: n8n dashboard → workflow → webhook → production URL.
VITE_WEBHOOK_URL=https://vkaruna.app.n8n.cloud/webhook/datiq
N8N_PUBLIC_WEBHOOK_URL=https://vkaruna.app.n8n.cloud/webhook/datiq
# Razorpay LIVE key id (server-side function).
# HOW TO OBTAIN: Razorpay dashboard → Settings → API Keys.
# DO: use live key in prod (rzp_live_...). DON'T: use test keys.
RAZORPAY_KEY_ID=REPLACE_ME
# Razorpay LIVE key secret (server-side function).
# HOW TO OBTAIN: Razorpay dashboard → Settings → API Keys.
# DO: keep secret in Secret Manager / operator env file. DON'T: commit or prefix with VITE_.
RAZORPAY_KEY_SECRET=REPLACE_ME
# Razorpay LIVE webhook secret for signature verification.
# HOW TO OBTAIN: Razorpay dashboard → Settings → Webhooks.
# DO: keep secret in Secret Manager / operator env file. DON'T: commit or prefix with VITE_.
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME

# ── 10. Frontend/tracker layer (production values) ───────────────────────────
# NOTE (current state): the GCP serving path is the COMMITTED
# public/runtime-config.js, which host-branches PostHog/GA PROD-only (PR #241)
# — these keys document the production values and become env-driven when the
# tracker layer switches to deploy-time rendering. Fill with the real values at
# cutover so the contract is complete.
GA_MEASUREMENT_ID=G-B0DZLRWG63
# PostHog project key — HOW TO OBTAIN: PostHog dashboard → Project Settings.
POSTHOG_KEY=REPLACE_ME
POSTHOG_HOST=https://us.i.posthog.com
CONSENT_POLICY_VERSION=2026-08-15
# Razorpay LIVE publishable checkout key. HOW TO OBTAIN: Razorpay dashboard →
# Settings → API Keys (rzp_live_...). Safe for the browser; the SECRET goes to
# Secret Manager only, never here.
VITE_RAZORPAY_KEY_ID=REPLACE_ME

# ── 11. Deploy/test hooks ────────────────────────────────────────────────────
# Playwright base URL: shadow during the parallel run, datiq.app post-cutover.
PW_BASE_URL=${SHADOW_BASE_URL}
# The URL smoke.sh curls: APP_BASE_URL (shadow) until the DNS flip.
SMOKE_TARGET=${APP_BASE_URL}
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=REPLACE_ME
# Shared secret for Cloud Scheduler → jobs service. HOW TO OBTAIN: `openssl rand
# -hex 24`; bootstrap-secrets.sh pushes it to Secret Manager. SECRET.
JOBS_TOKEN=REPLACE_ME
# Alert recipient used by the monitoring jobs. DO: a real operator inbox.
OPS_ALERT_EMAIL=REPLACE_ME

# ── 12. Staging coordinates for digest promotion (promote-prod.sh) ───────────
# promote-prod.sh prod (DIGESTS_FROM=staging, the default) resolves the
# staging-validated image digests from the STAGING project's registry and
# promotes them without rebuilding. HOW TO OBTAIN: copy the staging env values
# (gcloud artifacts docker images list on the staging repo gives the tag list).
STAGING_GCP_PROJECT_ID=vikash-saas-project
STAGING_GCP_REGION=asia-south1
STAGING_AR_REPO=datiq-vsp-ar-images-stg
# The staging image tag to promote (the git SHA staging was deployed from —
# build-images.sh tags images with the commit SHA, never `:staging`).
STAGING_IMG_TAG=REPLACE_ME_staging_git_sha
# ── 13. Runtime secret sources (deployment/gcp/secrets.manifest) ─────────────
# These are read from THIS file (or the operator override file) by
# bootstrap-secrets.sh and mounted on the api/jobs services from Secret
# Manager. A key left empty is skipped with a printed SKIP line — the service
# deploys without it and the affected feature degrades. ALL of the following
# are SECRETs: never commit real values anywhere except these gitignored env
# files (and Secret Manager itself).
# Firecrawl extraction API key (scrape backend). HOW TO OBTAIN: firecrawl.dev
# dashboard → API Keys (fc-…).
# DO: rotate if it ever appears in a bundle. DON'T: put in a VITE_ var.
FIRECRAWL_API_KEY=
# OpenAI API key (alternate AI provider). HOW TO OBTAIN: platform.openai.com →
# API keys (sk-…). DO: set only if the OpenAI provider chain is enabled.
OPENAI_API_KEY=
# Jina reader API key (scrape provider). HOW TO OBTAIN: jina.ai dashboard.
JINA_API_KEY=
# Spider.cloud API key (scrape provider). HOW TO OBTAIN: spider.cloud.
SPIDER_API_KEY=
# Resend API key (transactional email sending). HOW TO OBTAIN: resend.com →
# API Keys. DO: verify the sending domain for the env first.
RESEND_API_KEY=
# Ops admin PIN (plaintext, matched against ADMIN_PIN_HASH by the admin
# surface). HOW TO OBTAIN: owner chooses; hash with the repo's admin-hash tool.
# DO: rotate with ADMIN_TOKEN_SECRET. DON'T: reuse the production PIN here.
ADMIN_PIN=
# Ops admin PIN hash (scrypt/bcrypt of ADMIN_PIN). HOW TO OBTAIN: repo hash
# tool output. DO: treat as secret despite being a hash.
ADMIN_PIN_HASH=
# Ops admin JWT signing secret. HOW TO OBTAIN: `openssl rand -hex 32`.
# DO: rotate on any suspected admin-session leak.
ADMIN_TOKEN_SECRET=
# n8n webhook signature secret (verifies inbound n8n callbacks).
# HOW TO OBTAIN: shared with the n8n workflow credential config.
N8N_WEBHOOK_SECRET=
# n8n base URL for outbound callbacks (production webhooks root).
# HOW TO OBTAIN: n8n instance → webhook node URL prefix.
N8N_BASE_URL=
# n8n REST API key (workflow import/management). HOW TO OBTAIN: n8n →
# Settings → n8n API → create key.
DATIQ_N8N_API_KEY=
# Workflow orchestrator internal token (service-to-service calls).
# HOW TO OBTAIN: `openssl rand -hex 24`, shared with callers.
WORKFLOW_ORCHESTRATOR_TOKEN=
# Slack incoming-webhook URL for ops alerts. HOW TO OBTAIN: Slack →
# App directory → Incoming WebHooks → add to the ops channel.
SLACK_WEBHOOK_URL=
# Salt for guest-id hashing (privacy: avoids storing raw guest ids).
# HOW TO OBTAIN: `openssl rand -hex 16`. DON'T: change casually — it invalidates
# every existing guest id.
GUEST_ID_SALT=
# STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET — deliberately ABSENT while Stripe
# is deferred (docs/STRIPE-DEFERRAL.md). bootstrap-secrets.sh prints their SKIP

# AES-256-GCM key material for integration credentials (Slack/HubSpot/Notion
# access tokens). sha-256 of this value is the actual key.
# HOW TO OBTAIN: openssl rand -hex 32. DO: distinct per environment; rotating
# it makes previously stored credentials undecryptable (users must reconnect).
INTEGRATION_SECRETS_KEY=REPLACE_ME_openssl_rand_hex_32

# SELF-HOSTED GoTrue redirect allowlist (the hosted-dashboard 'Redirect URLs'
# equivalent). GoTrue validates OAuth redirect_to against this AFTER the
# provider consent — a missing entry bounces the user to the Site URL
# (the stg.datiq.app class of sign-in bug). Consumed by deploy-run.sh auth
# (GOTRUE_URI_ALLOW_LIST). DO: mirror runtime-config.js host routing.
GOTRUE_URI_ALLOW_LIST=https://datiq.app/**,https://www.datiq.app/**

# ── Social sign-in (self-hosted GoTrue) ──────────────────────────────────────
# Studio's Auth → Providers panel is read-only on self-hosted: providers are
# env vars on the auth Cloud Run service, applied by `deploy-run.sh prod auth`.
# Register this EXACT callback in each provider console: ${APP_BASE_URL}/auth/v1/callback
# = https://datiq-vsp-fhs-prod.web.app/auth/v1/callback while APP_BASE_URL is the
# shadow host. At the DNS flip set APP_BASE_URL=https://datiq.app, re-register
# https://datiq.app/auth/v1/callback in each console and run `deploy-run.sh prod auth`.
# GitHub OAuth Apps allow ONE callback URL: use a separate GitHub app per env.
# Google: Cloud Console → APIs & Services → Credentials → OAuth client (Web);
#   JS origins = the site hosts, redirect URI = the callback above.
# Microsoft: Azure → App registrations, "any org directory + personal accounts",
#   Web redirect = callback; secret = the client-secret VALUE, not its ID.
# GitHub: Settings → Developer settings → OAuth Apps; callback = above.
# A provider is only wired when *_ENABLED=true AND its client id is set; the
# secret is pushed to Secret Manager by bootstrap-secrets.sh (auth service only).
GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOTRUE_EXTERNAL_AZURE_ENABLED=false
GOTRUE_EXTERNAL_AZURE_CLIENT_ID=
GOTRUE_EXTERNAL_AZURE_URL=https://login.microsoftonline.com/common
AZURE_OAUTH_CLIENT_SECRET=
GOTRUE_EXTERNAL_GITHUB_ENABLED=false
GOTRUE_EXTERNAL_GITHUB_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ── Prospect Engagement Engine (outreach + consent) ──────────────────────────
# ENABLED=1: dispatcher + webhook + unsubscribe live. Set 0 to switch it all off.
# The three secrets are mounted from Secret Manager (secrets.manifest) on api+jobs:
#   ENGAGEMENT_RESEND_API_KEY      a Resend API key used ONLY for outreach (never
#                                  RESEND_API_KEY — the code does not fall back).
#   ENGAGEMENT_RESEND_WEBHOOK_SECRET  whsec_… of a Resend webhook pointed at
#                                  ${ENGAGEMENT_PUBLIC_URL}/api/engagement-webhook?provider=resend
#                                  (bounces, complaints, opt-outs). Per endpoint host.
#   ENGAGEMENT_UNSUBSCRIBE_SECRET  >=16 random chars (openssl rand -hex 32). Signs every
#                                  unsubscribe link; ROTATING IT BREAKS LINKS ALREADY SENT,
#                                  so prod must reuse Netlify's value until the DNS flip.
# ENGAGEMENT_PUBLIC_URL: BARE origin for unsubscribe links (no path, no /**).
ENGAGEMENT_ENABLED=1
ENGAGEMENT_MOCK_SEND=0
ENGAGEMENT_PUBLIC_URL=https://datiq.app
ENGAGEMENT_SENDER_DOMAINS=datiq.app
ENGAGEMENT_ALLOWLIST=REPLACE_ME_account_uuids_or_*,*.BETA=DatIQ
ENGAGEMENT_SEND_BUDGET_MS=7000
ENGAGEMENT_DISPATCH_BUDGET_MS=
ENGAGEMENT_RESEND_API_KEY=
ENGAGEMENT_RESEND_WEBHOOK_SECRET=
ENGAGEMENT_UNSUBSCRIBE_SECRET=

# ── Parity with Netlify's function env (see docs/plans/gcp-docker-migration/06 §7) ──
# Every line below exists on the Netlify site today and is read by the functions.
# deploy-run.sh forwards each one ONLY when non-empty (empty = code default).
# Outbound mail senders — one var per sender, no fallback chains between them.
ALERT_EMAIL_FROM=
BILLING_EMAIL_FROM=
CONTACT_EMAIL_FROM=
EXPORT_EMAIL_FROM=
FORM_EMAIL_FROM=
# Discoverability audit wall-clock budget (Cloud Run allows far more than Netlify's 10s).
AUDIT_BUDGET_MS=
# Kill switches. Netlify has all three =1 today (audit AI, citation sampling and
# PageSpeed are OFF in production). Leaving them out on GCP would silently turn
# those paid features ON. Set empty/0 to enable.
DISABLE_AI_CITATION_SAMPLING=
DISABLE_AUDIT_AI=
DISABLE_PAGESPEED=
# Purge safety interlocks (PURGE_ENABLED above stays 0): even if armed, dry-run + a cap of 1.
PURGE_DRY_RUN=1
PURGE_MAX_USERS_PER_RUN=
# Invoice supplier identity. GSTIN set = "Tax Invoice"; unset = "Payment Receipt".
SUPPLIER_LEGAL_NAME=
SUPPLIER_GSTIN=
SUPPLIER_ADDRESS=
SUPPLIER_STATE=
# Model for the Perplexity citation provider.
PERPLEXITY_MODEL=
# SECRETS (Secret Manager via secrets.manifest; values from Netlify, masked there):
#   PAGESPEED_API_KEY   Google PageSpeed (Cloud key; AI Studio AQ.* keys are rejected)
#   PERPLEXITY_API_KEY  Perplexity citation sampling
PAGESPEED_API_KEY=
PERPLEXITY_API_KEY=

# ── Build-time VITE_* parity with Netlify (baked into the bundle by deploy-hosting.sh) ──
# Anything left unset here falls back to a developer's LOCAL .env at build time.
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY are pinned from SUPABASE_URL /
# SUPABASE_ANON_KEY by deploy-hosting.sh itself.
VITE_PAYMENT_PROVIDER=auto
VITE_LINK_ABOUT=https://datiq.app/about
VITE_LINK_BLOG=https://datiq.app/blog
VITE_LINK_PRICING=https://datiq.app/pricing
VITE_RAZORPAY_PLAN_SELECT=999
VITE_RAZORPAY_PLAN_PRO=1499
VITE_RAZORPAY_PLAN_BUSINESS=3999
VITE_RAZORPAY_PLAN_AGENCY=149999

