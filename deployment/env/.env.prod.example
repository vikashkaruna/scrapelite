# ══════════════════════════════════════════════════════════════════════════════
# DatIQ PRODUCTION (GCP) — copy to deployment/env/.env.prod and fill.
# Phase 1c scaffolding (doc 06). Same contract as staging; differences below.
# Fill real values ONLY at the cutover rehearsal; nothing here is deployed yet.
# ══════════════════════════════════════════════════════════════════════════════

# ── 1. GCP core ──────────────────────────────────────────────────────────────
GCP_PROJECT_ID=vikash-saas-project
GCP_REGION=asia-south1
DATIQ_PROJECT_CODE=vsp
DATIQ_ENV=production
DATIQ_ENV_SUFFIX=-prod
DATIQ_OWNER_LABEL=vikash
GCP_BILLING_ACCOUNT_ID=REPLACE_ME

# ── 2. Resource names (doc 06 defaults) ──────────────────────────────────────
CLOUD_RUN_API=datiq-vsp-run-api-prod
CLOUD_RUN_JOBS=datiq-vsp-run-jobs-prod
CLOUD_RUN_AUTH=datiq-vsp-run-auth-prod
CLOUD_RUN_REST=datiq-vsp-run-rest-prod
CLOUD_RUN_ADMIN=datiq-vsp-run-admin-prod
CLOUD_RUN_TRACKERS=datiq-vsp-run-trackers-prod
AR_REPO=datiq-vsp-ar-images-prod
SQL_INSTANCE=datiq-vsp-sql-datiq-prod
SA_DEPLOY=datiq-vsp-sa-deploy
SA_API=datiq-vsp-sa-api-prod
SA_JOBS=datiq-vsp-sa-jobs-prod
SA_SCHEDULER=datiq-vsp-sa-scheduler-prod
TFSTATE_BUCKET=datiq-vsp-gcs-tfstate
ARTIFACTS_BUCKET=datiq-vsp-gcs-artifacts-prod
FHS_SITE_ID=datiq-vsp-fhs-prod
FB_WEB_APP_DISPLAY=DatIQ-vsp-fb-production-web

# ── 3. URLs — the shadow URL first; datiq.app only at cutover ────────────────
APP_BASE_URL=https://datiq.app          # post-cutover value; keep shadow separate
SHADOW_BASE_URL=https://datiq-vsp-fhs-prod.web.app
API_BASE_URL=${APP_BASE_URL}

# ── 4. Images (promote the staging-validated digest — no rebuild) ────────────
IMG_BASE=${GCP_REGION}-docker.pkg.dev/${GCP_PROJECT_ID}/${AR_REPO}
IMG_TAG=REPLACE_ME_promoted_digest
IMG_API=${IMG_BASE}/datiq-vsp-ctr-api:${IMG_TAG}

# ── 5. Database (prod sizing + protection) ───────────────────────────────────
DB_NAME=datiq
DB_APP_USER=datiq_app
DB_APP_PASSWORD=REPLACE_ME
CLOUD_SQL_TIER=db-custom-2-7680
CLOUD_SQL_HA=REGIONAL
CLOUD_SQL_BACKUP_PITR=1
CLOUD_SQL_CONNECTIVITY=private
PURGE_ENABLED=REPLACE_ME_explicit_decision

# ── 6. Data mode (hosted Supabase during shadow → Cloud SQL at cutover) ──────
DATA_MODE=hosted-supabase
SUPABASE_URL=REPLACE_ME_PROD_PROJECT_URL   # sikkfxysjhirmtwkumpt during shadow
SUPABASE_ANON_KEY=REPLACE_ME
SUPABASE_SERVICE_KEY=REPLACE_ME
# JWT_SECRET=                              # export from Supabase at cutover; Secret Manager only

# ── 7. Platform-env emulation ────────────────────────────────────────────────
APP_CONTEXT=production
GIT_BRANCH=main

# ── 8. Frontend/tracker layer (production values) ────────────────────────────
GA_MEASUREMENT_ID=G-B0DZLRWG63
POSTHOG_KEY=REPLACE_ME                    # same key production uses today
POSTHOG_HOST=https://us.i.posthog.com
CONSENT_POLICY_VERSION=2026-08-15
N8N_PUBLIC_WEBHOOK_URL=https://vkaruna.app.n8n.cloud/webhook/datiq

# ── 9. Deploy/test hooks ─────────────────────────────────────────────────────
PW_BASE_URL=${SHADOW_BASE_URL}
SMOKE_TARGET=${APP_BASE_URL}
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=REPLACE_ME
JOBS_TOKEN=REPLACE_ME
ENGAGEMENT_ENABLED=REPLACE_ME
OPS_ALERT_EMAIL=REPLACE_ME
