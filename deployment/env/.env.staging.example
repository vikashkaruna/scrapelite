# ══════════════════════════════════════════════════════════════════════════════
# DatIQ STAGING (GCP) — copy to deployment/env/.env.staging and fill.
# Phase 1a scaffolding (doc 06): operators edit ONLY this file; every script,
# Cloud Build substitution and Terraform variable reads from it. The names
# below follow the datiq-vsp convention; secrets are placeholders until
# bootstrap-secrets.sh runs. Nothing here is deployed yet.
# ══════════════════════════════════════════════════════════════════════════════

# ── 1. GCP core ──────────────────────────────────────────────────────────────
GCP_PROJECT_ID=vikash-saas-project        # owns ALL resources
GCP_REGION=asia-south1                    # Mumbai
DATIQ_PROJECT_CODE=vsp
DATIQ_ENV=staging
DATIQ_ENV_SUFFIX=-stg
DATIQ_OWNER_LABEL=vikash
GCP_BILLING_ACCOUNT_ID=REPLACE_ME

# ── 2. Resource names (doc 06 defaults) ──────────────────────────────────────
CLOUD_RUN_API=datiq-vsp-run-api-stg
CLOUD_RUN_JOBS=datiq-vsp-run-jobs-stg
CLOUD_RUN_AUTH=datiq-vsp-run-auth-stg
CLOUD_RUN_REST=datiq-vsp-run-rest-stg
CLOUD_RUN_ADMIN=datiq-vsp-run-admin-stg
CLOUD_RUN_TRACKERS=datiq-vsp-run-trackers-stg
AR_REPO=datiq-vsp-ar-images-stg
SQL_INSTANCE=datiq-vsp-sql-datiq-stg
SA_DEPLOY=datiq-vsp-sa-deploy
SA_API=datiq-vsp-sa-api-stg
SA_JOBS=datiq-vsp-sa-jobs-stg
SA_SCHEDULER=datiq-vsp-sa-scheduler-stg
TFSTATE_BUCKET=datiq-vsp-gcs-tfstate
ARTIFACTS_BUCKET=datiq-vsp-gcs-artifacts-stg
FHS_SITE_ID=datiq-vsp-fhs-stg
FB_WEB_APP_DISPLAY=DatIQ-vsp-fb-staging-web

# ── 3. URLs ──────────────────────────────────────────────────────────────────
APP_BASE_URL=https://datiq-vsp-fhs-stg.web.app
API_BASE_URL=${APP_BASE_URL}
SHADOW_BASE_URL=

# ── 4. Images (constructed from variables) ───────────────────────────────────
IMG_BASE=${GCP_REGION}-docker.pkg.dev/${GCP_PROJECT_ID}/${AR_REPO}
IMG_TAG=REPLACE_ME_git_sha
IMG_API=${IMG_BASE}/datiq-vsp-ctr-api:${IMG_TAG}

# ── 5. Database (staging proves the target model) ────────────────────────────
DB_NAME=datiq
DB_APP_USER=datiq_app
DB_APP_PASSWORD=REPLACE_ME
CLOUD_SQL_TIER=db-custom-1-3840
CLOUD_SQL_CONNECTIVITY=public-ssl
PURGE_ENABLED=0

# ── 6. Data mode ─────────────────────────────────────────────────────────────
DATA_MODE=hosted-supabase                 # dev project while validating
SUPABASE_URL=REPLACE_ME_DEV_PROJECT_URL
SUPABASE_ANON_KEY=REPLACE_ME
SUPABASE_SERVICE_KEY=REPLACE_ME
# JWT_SECRET=                              # needed only at GoTrue/Cloud SQL cutover

# ── 7. Platform-env emulation (adapter → URL/SITE_URL/CONTEXT/BRANCH) ────────
APP_CONTEXT=branch-deploy
GIT_BRANCH=staging

# ── 8. Frontend/tracker layer (rendered at deploy) ───────────────────────────
GA_MEASUREMENT_ID=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
CONSENT_POLICY_VERSION=2026-09-28
N8N_PUBLIC_WEBHOOK_URL=https://vkaruna.app.n8n.cloud/webhook-test/datiq

# ── 9. Deploy/test hooks ─────────────────────────────────────────────────────
PW_BASE_URL=${APP_BASE_URL}
SMOKE_TARGET=${APP_BASE_URL}
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=REPLACE_ME_local_path_or_CI_secret
JOBS_TOKEN=REPLACE_ME
