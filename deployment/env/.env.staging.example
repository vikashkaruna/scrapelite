# ══════════════════════════════════════════════════════════════════════════════
# DatIQ STAGING (GCP) — copy to deployment/env/.env.staging and fill.
#
#   HOW TO OBTAIN: `cp deployment/env/.env.staging.example deployment/env/.env.staging`
#   then fill REPLACE_ME values. Phase 1a is LIVE on this contract (2026-09-29).
#
#   Contract (doc 06): operators edit ONLY this file; every script, compose
#   file, Cloud Build substitution and the CI workflow read from it. Comments
#   MUST sit on their own lines above the value — inline `# trailing comments`
#   on value lines are NOT parsed away by the deploy tooling.
#   Every variable is documented as: [purpose] · [how to obtain] · DO / DON'T.
#
#   Doc 06: docs/plans/gcp-docker-migration/06-NAMING-AND-ENV-CONVENTIONS.md
#   Runbook: docs/plans/gcp-docker-migration/08-STAGING-DEPLOY-RUNBOOK.md
# ══════════════════════════════════════════════════════════════════════════════

# ── 1. GCP core ──────────────────────────────────────────────────────────────
# The GCP project that owns ALL staging resources.
# HOW TO OBTAIN: gcloud projects list. DO: use the dedicated project, never a shared one.
GCP_PROJECT_ID=vikash-saas-project
# Deploy region for Cloud Run, Cloud SQL, Scheduler, Artifact Registry.
# DO: keep the same region for everything (cold-start locality). DON'T: mix regions.
GCP_REGION=asia-south1
# Project code segment in every resource name (datiq-<code>-...). Changing it
# renames every resource — the parameterisation proof (doc 06 §9).
DATIQ_PROJECT_CODE=vsp
# Environment identity (staging). Used by the loader for .env.<env> resolution.
DATIQ_ENV=staging
# Resource-name suffix. DO: keep the doc-06 default -stg. DON'T: collide with prod (-prod).
DATIQ_ENV_SUFFIX=-stg
# Owner label on resources. HOW TO OBTAIN: your own label; used for firebase web app naming.
DATIQ_OWNER_LABEL=vikash
# GCP billing account — HOW TO OBTAIN: gcloud billing accounts list (needed only for project bootstrap).
GCP_BILLING_ACCOUNT_ID=REPLACE_ME

# ── 2. Resource names (doc 06 defaults) ──────────────────────────────────────
# Each name is a literal only HERE (the single allowed place) — scripts compose
# the same names from these values. DO: keep the datiq-<code>-<kind>-<suffix>
# pattern. DON'T: rename a live resource without running bootstrap again.
CLOUD_RUN_API=datiq-vsp-run-api-stg
# Cloud Run service for the scheduled jobs (no public ingress; Scheduler OIDC only).
CLOUD_RUN_JOBS=datiq-vsp-run-jobs-stg
# Cloud Run service for the GoTrue proof service (cutover target).
CLOUD_RUN_AUTH=datiq-vsp-run-auth-stg
# Cloud Run service for the PostgREST proof service (cutover target).
CLOUD_RUN_REST=datiq-vsp-run-rest-stg
# Cloud Run service serving the /admin* surface.
CLOUD_RUN_ADMIN=datiq-vsp-run-admin-stg
# Cloud Run service serving runtime-config.js + analytics.js.
CLOUD_RUN_TRACKERS=datiq-vsp-run-trackers-stg
# Cloud Run service for private Supabase Studio connected to Cloud SQL.
# HOW TO OBTAIN: Doc 06 naming convention datiq-<code>-run-studio-<suffix>.
# DO: Keep private (--no-allow-unauthenticated). DON'T: expose publicly without IAP.
CLOUD_RUN_STUDIO=datiq-vsp-run-studio-stg
# Local host port used by proxy-studio.sh to access private Cloud Run Studio.
# HOW TO OBTAIN: Choose an unused local port (default 54328 matches local studio port).
# DO: Parameterise per operator workstation. DON'T: conflict with local DB (54329).
STUDIO_HOST_PORT=54328
# Container port Supabase Studio listens on inside Cloud Run (Next.js default 3000).
# HOW TO OBTAIN: Upstream studio default container port.
# DO: Keep 3000. DON'T: change unless custom studio build requires different port.
STUDIO_PORT=3000
# Artifact Registry Docker repository holding all app images.
AR_REPO=datiq-vsp-ar-images-stg
# Cloud SQL Postgres instance (dump/restore rehearsal target).
SQL_INSTANCE=datiq-vsp-sql-datiq-stg
# Deploy service account (runs Cloud Run/Hosting/Scheduler/Secret ops).
SA_DEPLOY=datiq-vsp-sa-deploy
# Runtime service account for the api service.
SA_API=datiq-vsp-sa-api-stg
# Runtime service account for the jobs service.
SA_JOBS=datiq-vsp-sa-jobs-stg
# Service account Cloud Scheduler authenticates as (OIDC).
SA_SCHEDULER=datiq-vsp-sa-scheduler-stg
# GCS bucket for build artifacts (created by bootstrap.sh).
ARTIFACTS_BUCKET=datiq-vsp-gcs-artifacts-stg
# Firebase Hosting site id — the staging origin's subdomain.
# ⚠️ A Firebase site id can NEVER be recreated once deleted (down.sh keeps the
# site by default for this reason). Renamed 2026-10-01 after the original id
# was burned by a pre-fix teardown: datiq-vsp-fhs-stg → datiq-vsp-fhs-staging.
FHS_SITE_ID=datiq-vsp-fhs-staging
# Firebase web app display name (bootstrap.sh creates it).
FB_WEB_APP_DISPLAY=DatIQ-vsp-fb-staging-web

# ── 3. URLs ──────────────────────────────────────────────────────────────────
# The Firebase Hosting origin — the staging site's canonical URL (smoke target).
# Keep in step with FHS_SITE_ID (and GOTRUE_URI_ALLOW_LIST) when it changes.
APP_BASE_URL=https://datiq-vsp-fhs-staging.web.app
# API origin for callers; equals APP_BASE_URL on GCP (rewrites proxy to Cloud Run).
API_BASE_URL=${APP_BASE_URL}
# The production-twin ("shadow") URL — only used in Phase 1b (prod), empty for staging.
SHADOW_BASE_URL=

# ── 4. Images (constructed from variables) ───────────────────────────────────
# Registry base composed from region/project/repo. DO: never hand-edit.
IMG_BASE=${GCP_REGION}-docker.pkg.dev/${GCP_PROJECT_ID}/${AR_REPO}
# Tag every image is pushed under. DO: use the git SHA of the deployed commit
# (CI sets it from ${{ github.sha }}); build-images.sh defaults to HEAD.
IMG_TAG=REPLACE_ME_git_sha
# The api image (jobs reuses the SAME image with a different entrypoint).
IMG_API=${IMG_BASE}/datiq-vsp-ctr-api:${IMG_TAG}
# Admin surface image (same repo/tag pattern).
IMG_ADMIN=${IMG_BASE}/datiq-vsp-ctr-admin:${IMG_TAG}
# Trackers surface image (same repo/tag pattern).
IMG_TRACKERS=${IMG_BASE}/datiq-vsp-ctr-trackers:${IMG_TAG}

# ── 5. Database (Cloud SQL rehearsal target) ─────────────────────────────────
# Postgres database name on the Cloud SQL instance (created by migrate-db.sh).
DB_NAME=datiq
# App-facing login role (used by migrate-db.sh; the api talks to hosted
# Supabase while DATA_MODE=hosted-supabase, so this only backs the proof services).
DB_APP_USER=datiq_app
# Password for DB_APP_USER. HOW TO OBTAIN: `openssl rand -hex 24` (or a vault).
# SECRET — kept in this gitignored operator file, never in a repo file.
DB_APP_PASSWORD=REPLACE_ME
# Cloud SQL machine tier. DO: smallest viable for staging (db-custom-1-3840).
CLOUD_SQL_TIER=db-custom-1-3840
# Cloud SQL edition (ENTERPRISE default). DO: keep ENTERPRISE for parity with prod.
CLOUD_SQL_EDITION=ENTERPRISE
# High-availability mode: ZONAL is right for staging; prod uses REGIONAL.
CLOUD_SQL_HA=ZONAL
# 1 = enable point-in-time recovery (recommended for prod; costs storage).
CLOUD_SQL_BACKUP_PITR=0
# Instance connectivity: public-ssl (default; the proxy path needs public IP)
# or private (requires VPC/private-services-access — configure manually BEFORE
# relying on it; migrate-db.sh warns when this is set to private).
CLOUD_SQL_CONNECTIVITY=public-ssl
# Daily backup window start (HH:MM UTC) passed at instance creation.
CLOUD_SQL_BACKUP_START=09:00
# Local cloud-sql-proxy port used by migrate-db.sh (any free port).
CLOUD_SQL_PROXY_PORT=15432
# 1 = enable destructive purge jobs. DO: 0 on staging (Netlify staging owns crons anyway).
PURGE_ENABLED=0

# ── 6. Data mode: hosted dev Supabase (the parallel-run window) ──────────────
# hosted-supabase = the app reads/writes the hosted DEV/STAGING Supabase project
# (frontend calls it directly — no /auth or /rest Hosting rewrites needed).
# cloud-sql = self-hosted trio (auth/rest rewrite into the Cloud Run proof
# services) — this flips only at the real cutover; gen-firebase-config emits the
# /auth/v1+/rest/v1 rewrites ONLY in this mode.
# DO: keep hosted-supabase until Phase 1c cutover. DON'T: flip without the runbook.
DATA_MODE=hosted-supabase
# Staging Supabase project ref — HOW TO OBTAIN: Supabase dashboard URL subdomain
# (Project Settings → General). Used by migrate-db.sh for the dump/restore rehearsal.
SOURCE_PROJECT_REF=REPLACE_ME_dev_project_ref
# The staging/dev Supabase project URL + anon key (dashboard → Settings → API).
# HOW TO OBTAIN: copy from the repo-root .env VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY.
SUPABASE_URL=REPLACE_ME_DEV_PROJECT_URL
# anon key — public by design, embedded in the frontend bundle.
SUPABASE_ANON_KEY=REPLACE_ME
# service_role key — SECRET: server-side only (api/jobs env + Secret Manager).
SUPABASE_SERVICE_KEY=REPLACE_ME
# GoTrue/PostgREST JWT secret — staging-only: migrate-db.sh generates one and
# appends it here. At the REAL cutover, set this to the PROD Supabase JWT secret
# (keeps sessions valid across the flip). DO: never reuse across envs until cutover.
# JWT_SECRET=
# Auto-confirm user email on GoTrue signup (staging proof service).
# HOW TO OBTAIN: set "true" for staging testing so signups don't require external email delivery.
# DO: keep true on staging. DON'T: set true in prod.
GOTRUE_MAILER_AUTOCONFIRM=true

# ── 7. Upstream proof-service images (local-verified versions) ───────────────
# Mirrored into Artifact Registry by stage-third-party.yaml (Cloud Run cannot
# pull public.ecr.aws directly). DO: bump only when the local stack verified the
# new upstream version. DON'T: use unmirrored public images on Cloud Run.
# e.g. asia-south1-docker.pkg.dev/<project>/<repo>/datiq-vsp-ctr-gotrue:staged
AUTH_IMAGE=REPLACE_ME_after_stage-third-party
# e.g. .../datiq-vsp-ctr-postgrest:staged
REST_IMAGE=REPLACE_ME_after_stage-third-party
# Mirrored into Artifact Registry by stage-studio.sh (Cloud Run cannot pull public.ecr.aws directly).
# HOW TO OBTAIN: Upstream public.ecr.aws/supabase/studio:2026.07.06-sha-66cf431.
# DO: Use verified Supabase studio tag. DON'T: use unmirrored public images on Cloud Run.
STUDIO_IMAGE=REPLACE_ME_after_stage-third-party
# Mirrored into Artifact Registry by stage-studio.sh (Cloud Run cannot pull public.ecr.aws directly).
# HOW TO OBTAIN: Upstream public.ecr.aws/supabase/postgres-meta:v0.96.6.
# DO: Use companion postgres-meta version. DON'T: use unmirrored public images on Cloud Run.
PG_META_IMAGE=REPLACE_ME_after_stage-third-party

# ── 8. Platform-env emulation (adapter → URL/SITE_URL/CONTEXT/BRANCH) ────────
# Netlify CONTEXT emulation: branch-deploy = staging behaviour (demo admin OFF).
APP_CONTEXT=branch-deploy
# Netlify BRANCH emulation passed to functions.
GIT_BRANCH=staging

# ── 9. Runtime feature knobs (set on the Cloud Run services) ─────────────────
# 1 = the GCP jobs/scheduler DO NOT take cron ownership — Netlify staging keeps
# running the crons (parallel-run rule, doc 05 §3b: never both). Flip at cutover.
OPS_JOBS_DISABLED=1
# 1 = engagement dispatcher enabled (0 = off for staging).
ENGAGEMENT_ENABLED=0
# Hour the @daily Cloud Scheduler jobs fire (all 5 dailies share this tick).
DAILY_HOUR_UTC=3
# Wall-clock budgets (ms) for one /api/ai and one /api/extract call chain.
# Defaults are 8000 each, tuned for Netlify's 10s function cap. Staging runs
# on Cloud Run with --timeout=300, where those defaults deadline-cut heavy
# template runs (deep synthesis falling through all three providers; a
# reasoning-model structured extraction over a page plus gathered subpages →
# "run is incomplete"). HOW TO OBTAIN: operator choice. DO: raise on Cloud
# Run environments (these values leave >6x headroom under the 300s cap).
# DON'T: carry values this large to any Netlify-hosted deployment — the
# platform kills the function first.
AI_BUDGET_MS=30000
EXTRACT_BUDGET_MS=45000
# Site name injected into the function env.
SITE_NAME=DatIQ
# Scrape provider fallback order (comma-separated; direct first).
SCRAPE_PROVIDER_ORDER=direct,spider,jina
# AI model id used by the AI service (function-side).
VITE_AI_MODEL=claude-haiku-4-5-20251001
# Anthropic sk-ant-... (console.anthropic.com → API Keys) — preferred key name for Anthropic.
# HOW TO OBTAIN: console.anthropic.com → API Keys.
# DO: keep server-side only. DON'T: prefix with VITE_.
ANTHROPIC_API_KEY=REPLACE_ME
# Google AI Studio key
# HOW TO OBTAIN: aistudio.google.com/apikey.
# DO: keep server-side only. DON'T: prefix with VITE_.
GEMINI_API_KEY=REPLACE_ME
# Gemini model override for fast tier (classification, tagging, short extractions).
# HOW TO OBTAIN: valid model from Google AI Studio (gemini-3.8-flash, gemini-flash-latest).
# DO: use active non-retired model IDs. DON'T: use retired 2.x models.
GEMINI_MODEL_FAST=gemini-3.8-flash
# Gemini model override for deep tier (reports, synthesis, complex extractions).
# HOW TO OBTAIN: valid model from Google AI Studio (gemini-pro-latest).
# DO: use active non-retired model IDs. DON'T: use retired 2.x models.
GEMINI_MODEL_DEEP=gemini-pro-latest
# OpenAI model override for fast tier (classification, tagging, short jobs).
# HOW TO OBTAIN: platform.openai.com → models (gpt-6-luna, gpt-6-sol).
# DO: use active model IDs. DON'T: pin a retired generation.
OPENAI_MODEL_FAST=gpt-6-luna
# OpenAI model override for deep tier (extraction, enrichment, synthesis).
# HOW TO OBTAIN: platform.openai.com → models.
# DO: same id as _FAST is fine (Luna covers both tiers). DON'T: leave stale pins.
OPENAI_MODEL_DEEP=gpt-6-luna
# Anthropic model override for fast tier (high-speed execution).
# HOW TO OBTAIN: docs.anthropic.com → models (claude-haiku-4-5-20251001).
# DO: keep server-side. DON'T: prefix with VITE_.
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
# Anthropic model override for deep tier (everyday professional work:
# discoverability, workflow templates).
# HOW TO OBTAIN: docs.anthropic.com → models (claude-sonnet-5).
ANTHROPIC_MODEL_DEEP=claude-sonnet-5
# Perplexity model overrides (answer-engine citation sampling).
# HOW TO OBTAIN: docs.perplexity.ai (sonar, sonar-pro).
PERPLEXITY_MODEL_FAST=sonar
PERPLEXITY_MODEL_DEEP=sonar-pro
# Global AI provider fallback order (comma-separated provider ids). Empty =
# code default: openai,gemini,anthropic (owner-set 2026-09-30). /admin/ai can
# re-order globally and per-area at runtime without a deploy.
# DO: keep all three present so a dead provider degrades, never drops.
AI_PROVIDER_ORDER=
# n8n webhook the app calls. DO: use the /webhook-test/ URL for staging — it
# only answers while the n8n editor is open; the production workflow needs
# /webhook/ + activation + CORS. HOW TO OBTAIN: n8n dashboard → workflow → webhook.
VITE_WEBHOOK_URL=https://vkaruna.app.n8n.cloud/webhook-test/datiq
# n8n webhook URL the orchestrator calls (test URL for staging).
N8N_PUBLIC_WEBHOOK_URL=https://vkaruna.app.n8n.cloud/webhook-test/datiq
# Razorpay key id (server-side function).
# HOW TO OBTAIN: Razorpay dashboard → Settings → API Keys.
# DO: use test keys for staging (rzp_test_...). DON'T: use live keys outside prod.
RAZORPAY_KEY_ID=REPLACE_ME
# Razorpay key secret (server-side function).
# HOW TO OBTAIN: Razorpay dashboard → Settings → API Keys.
# DO: keep secret in Secret Manager / operator env file. DON'T: commit or prefix with VITE_.
RAZORPAY_KEY_SECRET=REPLACE_ME
# Razorpay webhook secret for signature verification.
# HOW TO OBTAIN: Razorpay dashboard → Settings → Webhooks.
# DO: keep secret in Secret Manager / operator env file. DON'T: commit or prefix with VITE_.
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME

# ── 10. Frontend build-time + tracker layer ──────────────────────────────────
# Razorpay publishable checkout key (build-time). HOW TO OBTAIN: Razorpay
# dashboard → Settings → API Keys (rzp_test_ for staging). Safe for the browser.
VITE_RAZORPAY_KEY_ID=REPLACE_ME
# RESERVED — analytics keys. NOTE (current state): the GCP serving path is the
# COMMITTED public/runtime-config.js, which host-branches PostHog/GA PROD-only
# (PR #241 gating) — so these keys do NOT change staging behaviour today. They
# become env-driven when the tracker layer switches to deploy-time rendering
# (gen-runtime-config, doc 06); fill them then.
GA_MEASUREMENT_ID=
# RESERVED — PostHog project key (see the analytics note above §10).
POSTHOG_KEY=
# PostHog ingestion host (eu/us region per your project).
POSTHOG_HOST=https://us.i.posthog.com
# Consent-policy version embedded in the tracker payload (bump on policy changes).
CONSENT_POLICY_VERSION=2026-09-28

# ── 11. Generated deploy tokens ──────────────────────────────────────────────
# Shared secret for Cloud Scheduler → jobs service (x-datiq-cron-token, stands
# in for OIDC on the adapter). HOW TO OBTAIN: `openssl rand -hex 24`; bootstrap
# -secrets.sh pushes it to Secret Manager. SECRET — never commit the real one.
JOBS_TOKEN=REPLACE_ME

# ── 12. Deploy/test hooks ────────────────────────────────────────────────────
# Playwright base URL for CI suites against the deployed staging site.
PW_BASE_URL=${APP_BASE_URL}
# The URL smoke.sh curls (override to smoke a different target).
SMOKE_TARGET=${APP_BASE_URL}
# Path to a Firebase service-account JSON for CI hosting deploys. HOW TO OBTAIN:
# GCP IAM → service account → key. Local deploys use ADC — leave empty locally.
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=REPLACE_ME_local_path_or_CI_secret
# ── Generated by migrate-db.sh (append-only; do not hand-edit) ────────────────
# DB_ADMIN_PASSWORD=            # generated once on first run, appended below
# JWT_SECRET=                   # generated by migrate-db.sh (staging-only); see §6

# ── 13. Runtime secret sources (deployment/gcp/secrets.manifest) ─────────────
# These are read from THIS file (or the operator override file) by
# bootstrap-secrets.sh and mounted on the api/jobs services from Secret
# Manager. A key left empty is skipped with a printed SKIP line — the service
# deploys without it and the affected feature degrades. ALL of the following
# are SECRETs: never commit real values anywhere except these gitignored env
# files (and Secret Manager itself).
# Firecrawl extraction API key (scrape backend). HOW TO OBTAIN: firecrawl.dev
# dashboard → API Keys (fc-…).
# DO: rotate if it ever appears in a bundle. DON'T: put in a VITE_ var.
FIRECRAWL_API_KEY=
# OpenAI API key (alternate AI provider). HOW TO OBTAIN: platform.openai.com →
# API keys (sk-…). DO: set only if the OpenAI provider chain is enabled.
OPENAI_API_KEY=
# Jina reader API key (scrape provider). HOW TO OBTAIN: jina.ai dashboard.
JINA_API_KEY=
# Spider.cloud API key (scrape provider). HOW TO OBTAIN: spider.cloud.
SPIDER_API_KEY=
# Resend API key (transactional email sending). HOW TO OBTAIN: resend.com →
# API Keys. DO: verify the sending domain for the env first.
RESEND_API_KEY=
# Ops admin PIN (plaintext, matched against ADMIN_PIN_HASH by the admin
# surface). HOW TO OBTAIN: owner chooses; hash with the repo's admin-hash tool.
# DO: rotate with ADMIN_TOKEN_SECRET. DON'T: reuse the production PIN here.
ADMIN_PIN=
# Ops admin PIN hash (scrypt/bcrypt of ADMIN_PIN). HOW TO OBTAIN: repo hash
# tool output. DO: treat as secret despite being a hash.
ADMIN_PIN_HASH=
# Ops admin JWT signing secret. HOW TO OBTAIN: `openssl rand -hex 32`.
# DO: rotate on any suspected admin-session leak.
ADMIN_TOKEN_SECRET=
# n8n webhook signature secret (verifies inbound n8n callbacks).
# HOW TO OBTAIN: shared with the n8n workflow credential config.
N8N_WEBHOOK_SECRET=
# n8n base URL for outbound callbacks (production webhooks root).
# HOW TO OBTAIN: n8n instance → webhook node URL prefix.
N8N_BASE_URL=
# n8n REST API key (workflow import/management). HOW TO OBTAIN: n8n →
# Settings → n8n API → create key.
DATIQ_N8N_API_KEY=
# Workflow orchestrator internal token (service-to-service calls).
# HOW TO OBTAIN: `openssl rand -hex 24`, shared with callers.
WORKFLOW_ORCHESTRATOR_TOKEN=
# Slack incoming-webhook URL for ops alerts. HOW TO OBTAIN: Slack →
# App directory → Incoming WebHooks → add to the ops channel.
SLACK_WEBHOOK_URL=
# Salt for guest-id hashing (privacy: avoids storing raw guest ids).
# HOW TO OBTAIN: `openssl rand -hex 16`. DON'T: change casually — it invalidates
# every existing guest id.
GUEST_ID_SALT=
# Resend webhook signing secret (verifies inbound engagement events).
# HOW TO OBTAIN: Resend dashboard → Webhooks → signing secret.
ENGAGEMENT_RESEND_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET — deliberately ABSENT while Stripe
# is deferred (docs/STRIPE-DEFERRAL.md). bootstrap-secrets.sh prints their SKIP
# lines; re-add here when Stripe is re-enabled.

# AES-256-GCM key material for integration credentials (Slack/HubSpot/Notion
# access tokens). sha-256 of this value is the actual key.
# HOW TO OBTAIN: openssl rand -hex 32. DO: distinct per environment; rotating
# it makes previously stored credentials undecryptable (users must reconnect).
INTEGRATION_SECRETS_KEY=REPLACE_ME_openssl_rand_hex_32

# SELF-HOSTED GoTrue redirect allowlist (the hosted-dashboard 'Redirect URLs'
# equivalent). GoTrue validates OAuth redirect_to against this AFTER the
# provider consent — a missing entry bounces the user to the Site URL
# (the stg.datiq.app class of sign-in bug). Consumed by deploy-run.sh auth
# (GOTRUE_URI_ALLOW_LIST). DO: mirror runtime-config.js host routing.
GOTRUE_URI_ALLOW_LIST=https://datiq.app/**,https://stg.datiq.app/**,https://staging--datiqapp.netlify.app/**
