# ══════════════════════════════════════════════════════════════════════════════
# DatIQ local environment — copy to deployment/env/.env.local and edit.
# ONLY THIS FILE is edited to change the local deploy. Nothing else is touched.
# (Doc 06: docs/plans/gcp-docker-migration/06-NAMING-AND-ENV-CONVENTIONS.md)
# ══════════════════════════════════════════════════════════════════════════════

# ── 1. Stack identity ─────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=datiq-local       # prefixes networks/volumes; container names: datiq-local-*
DATIQ_ENV=local
DATA_MODE=local-db                     # local-db (db+auth+rest containers) | shared-db (hosted dev Supabase)
LOCAL_GATEWAY_PORT=8080                # the single entry: http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080  # what the app believes its origin is (email links, OAuth return)
APP_CONTEXT=branch-deploy              # Netlify CONTEXT emulation — branch-deploy = staging-like (demo admin OFF)
GIT_BRANCH=local

# ── 2. Auth / database (local-db mode) ────────────────────────────────────────
# JWT_SECRET signs GoTrue tokens AND the anon/service API keys AND PostgREST
# validation. Any 32+ char random string. Generated fresh for you in .env.local.
JWT_SECRET=REPLACE_ME_openssl_rand_hex_32
POSTGRES_PASSWORD=REPLACE_ME_openssl_rand_hex_24
DB_HOST_PORT=54329                     # host-side Postgres port (127.0.0.1) for psql / pg_restore

# ── 3. Jobs (cron) ────────────────────────────────────────────────────────────
JOBS_TOKEN=REPLACE_ME_openssl_rand_hex_24
# SCHEDULES_JSON (optional) overrides the built-in 13-cron map (same jobs as
# netlify.toml). Leave unset for the default.

# ── 4. Supabase endpoints used by the API containers ──────────────────────────
# local-db mode → everything through the gateway on the docker network.
SUPABASE_URL=http://gateway:8080
# shared-db mode → point these at the hosted DEV project instead (values live in
# the repo-root .env; copy them here if you switch DATA_MODE=shared-db).
# SUPABASE_URL=https://<dev-project>.supabase.co

# ── 5. Container images (pinned — override on pull failure) ───────────────────
IMAGE_TAG=local
DB_IMAGE=REPLACE_ME_after_first_pull   # e.g. supabase/postgres:15.8.1.049
AUTH_IMAGE=REPLACE_ME_after_first_pull # e.g. supabase/auth:v2.163.2
REST_IMAGE=REPLACE_ME_after_first_pull # e.g. postgrest/postgrest:v12.2.3
MAILPIT_IMAGE=REPLACE_ME_after_first_pull # e.g. axllent/mailpit:v1.22
DAILY_HOUR_UTC=3                       # hour the daily cron jobs fire in the local scheduler sim

# ── 6. Runtime keys for the API containers (copied from the repo-root .env) ───
# These make the local stack behave like staging: real scrape/AI/email/billing
# providers. Values below are SAMPLES — .env.local carries the real ones.
VITE_SUPABASE_URL=REPLACE_ME           # dev project (shared-db mode + gen-config fallback)
VITE_SUPABASE_ANON_KEY=REPLACE_ME
SUPABASE_SERVICE_KEY=REPLACE_ME        # dev project service key (shared-db mode)
FIRECRAWL_API_KEY=REPLACE_ME
AI_API_KEY=REPLACE_ME
GEMINI_API_KEY=REPLACE_ME
OPENAI_API_KEY=REPLACE_ME
JINA_API_KEY=REPLACE_ME
SPIDER_API_KEY=REPLACE_ME
SCRAPE_PROVIDER_ORDER=REPLACE_ME
RESEND_API_KEY=REPLACE_ME
VITE_AI_MODEL=REPLACE_ME
ADMIN_PIN=REPLACE_ME                   # /admin PIN (server-verified)
ADMIN_PIN_HASH=REPLACE_ME
ADMIN_TOKEN_SECRET=REPLACE_ME
RAZORPAY_KEY_ID=REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME
VITE_RAZORPAY_KEY_ID=REPLACE_ME
VITE_WEBHOOK_URL=https://vkaruna.app.n8n.cloud/webhook-test/datiq

# ── 7. DB migration from staging Supabase (scripts/migrate-from-supabase.sh) ──
# PREFERRED — CLI path (no database password needed):
#   SUPABASE_ACCESS_TOKEN=<token>          # already in the repo-root .env
#   SOURCE_PROJECT_REF=<staging-ref>       # e.g. aubwooslkkrprdxuiyvj
#   → script runs `supabase db dump` (schema + data incl. auth users) and
#     restores into the local DB automatically.
# ALTERNATIVE — direct path (needs the DB password):
#   Paste the staging project's connection string (Supabase dashboard →
#   Project Settings → Database → Connection string → URI, session pooler):
#   postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
SOURCE_DB_URL=
SOURCE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
# Comma-separated tables to skip during the dump (optional, e.g. huge audit logs):
MIGRATE_EXCLUDE_TABLES=

# ── 8. Flags ──────────────────────────────────────────────────────────────────
PURGE_ENABLED=0
ENGAGEMENT_ENABLED=0
OPS_JOBS_DISABLED=0
ENGAGEMENT_MOCK_SEND=1
