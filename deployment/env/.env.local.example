# ══════════════════════════════════════════════════════════════════════════════
# DatIQ LOCAL environment — copy to deployment/env/.env.local and edit.
#
#   HOW TO OBTAIN: `cp deployment/env/.env.local.example deployment/env/.env.local`
#   then fill the REPLACE_ME values. Run `deployment/scripts/up.sh` after edits.
#
#   Contract: ONLY this file drives the local deploy (doc 06 golden rule 1 —
#   never edit compose files, Dockerfiles or scripts to change a deployment).
#   Every variable below is documented as:
#     [purpose] · [how to obtain] · DO / DON'T
#
#   Doc 06: docs/plans/gcp-docker-migration/06-NAMING-AND-ENV-CONVENTIONS.md
# ══════════════════════════════════════════════════════════════════════════════

# ── 1. Stack identity ─────────────────────────────────────────────────────────
# Container/network/volume naming prefix. Changing it renames every container
# and image (the parameterisation proof, doc 06 §9).
# DO: keep it unique per checkout (two stacks on one machine). DON'T: use spaces.
COMPOSE_PROJECT_NAME=datiq-local
# The env name the loader resolves (.env.<DATIQ_ENV>). Always "local" here.
DATIQ_ENV=local
# Data mode — WHERE the stack's auth/DB live.
#   local-db  : full supabase-lite in Docker (db + GoTrue + PostgREST + Mailpit) — the default; migration rehearsals run here.
#   shared-db : API + auth point at the hosted DEV Supabase project (no local DB containers; signon uses existing dev accounts).
# DO: use local-db for rehearsals, shared-db for quick dev against live data.
# DON'T: point shared-db at staging/prod Supabase.
DATA_MODE=local-db
# Host port the gateway (single entry point) listens on. DO: change only if 8080 is taken.
LOCAL_GATEWAY_PORT=8080
# Host port for the Mailpit UI (http://127.0.0.1:8025) — captured mail only.
MAILPIT_UI_PORT=8025
# The origin the app believes it has (email links, OAuth return URLs, redirects).
# DO: use http://localhost:<LOCAL_GATEWAY_PORT>. DON'T: use 127.0.0.1 — OAuth/email link round-trips differ.
PUBLIC_BASE_URL=http://localhost:8080
# Netlify CONTEXT emulation. branch-deploy = staging-like behaviour (demo admin OFF, non-prod flags).
# DO: keep branch-deploy for local parity with staging. DON'T: set production locally.
APP_CONTEXT=branch-deploy
# Netlify BRANCH emulation (adapter passes it to functions).
GIT_BRANCH=local

# ── 2. Auth / database (local-db mode) ────────────────────────────────────────
# Signs GoTrue JWTs AND mints the anon/service API keys AND validates PostgREST
# requests — one secret, three surfaces (same shape as the Supabase contract).
# HOW TO OBTAIN: `openssl rand -hex 32` (any 32+ char random string). Generated
# for you in .env.local by the generator when left as REPLACE_ME.
# DO: keep it identical across stack rebuilds if you want existing sessions to
# survive. DON'T: commit .env.local (it is gitignored); never reuse the prod secret.
JWT_SECRET=REPLACE_ME_openssl_rand_hex_32
# The local postgres superuser password (supabase/postgres image POSTGRES_PASSWORD).
# HOW TO OBTAIN: `openssl rand -hex 24`.
# DO: treat as a secret. DON'T: reuse your laptop/team password.
POSTGRES_PASSWORD=REPLACE_ME_openssl_rand_hex_24
# Host-side Postgres port for psql/pg_restore access to the local db container.
# DO: keep 54329 (deliberately NOT 5432 to avoid clashing with a host Postgres).
DB_HOST_PORT=54329
# Auto-confirm user email on signup (no confirmation email sent; session returned immediately).
# HOW TO OBTAIN: set "true" for local/test stacks without SMTP, "false" for production with email verification.
# DO: keep true locally so test signups work without checking Mailpit. DON'T: set true in production.
GOTRUE_MAILER_AUTOCONFIRM=true

# ── 3. Jobs (cron) ────────────────────────────────────────────────────────────
# Shared secret for POST /run/<name> on the jobs service (the local stand-in for
# Cloud Scheduler OIDC). HOW TO OBTAIN: `openssl rand -hex 24`.
# DO: keep in sync with the scheduler container env. DON'T: reuse across envs.
JOBS_TOKEN=REPLACE_ME_openssl_rand_hex_24
# (optional) JSON overriding the built-in 13-cron map (same jobs as netlify.toml).
# DO: leave unset for the default. DON'T: add crons that don't exist on Netlify/GCP.

# ── 4. Supabase endpoints used by the API containers ──────────────────────────
# local-db mode → everything goes through the gateway on the docker network
# (the browser calls localhost:8080/rest/v1 and the gateway proxies).
SUPABASE_URL=http://gateway:8080
# shared-db mode → point at the hosted DEV project instead:
#   HOW TO OBTAIN: Supabase dashboard → Project Settings → API → Project URL /
#   anon public key (also present in the repo-root .env VITE_SUPABASE_URL).
#   Copy both here when switching DATA_MODE=shared-db.
# SUPABASE_URL=https://<dev-project>.supabase.co
# SUPABASE_ANON_KEY=<dev-project-anon-key>

# ── 5. Container images (pinned — override on pull failure) ───────────────────
# Image tag applied to the locally built images (datiq-local-ctr-*:local).
IMAGE_TAG=local
# Pinned upstream images for the supabase-lite profile (db/auth/rest/mailpit).
# HOW TO OBTAIN: leave REPLACE_ME on first run — up.sh fills the actual pins
# into .env.local. Override only to pin a newer upstream version deliberately.
# DO: bump deliberately, one at a time, then re-run the smoke. DON'T: use "latest".
# e.g. supabase/postgres:15.8.1.049
DB_IMAGE=REPLACE_ME_after_first_pull
# e.g. supabase/auth:v2.163.2
AUTH_IMAGE=REPLACE_ME_after_first_pull
# e.g. postgrest/postgrest:v12.2.3
REST_IMAGE=REPLACE_ME_after_first_pull
# e.g. axllent/mailpit:v1.22
MAILPIT_IMAGE=REPLACE_ME_after_first_pull
# Host port for Supabase Studio UI (http://127.0.0.1:54328) — table browser and SQL editor.
# DO: change only if 54328 is taken.
STUDIO_HOST_PORT=54328
# Pinned upstream image for Supabase Studio (local web UI).
# HOW TO OBTAIN: public.ecr.aws/supabase/studio:<tag>
# DO: bump deliberately. DON'T: use "latest".
STUDIO_IMAGE=public.ecr.aws/supabase/studio:2026.07.06-sha-66cf431
# Pinned upstream image for postgres-meta (Studio backend).
# HOW TO OBTAIN: public.ecr.aws/supabase/postgres-meta:<tag>
# DO: bump deliberately. DON'T: use "latest".
PG_META_IMAGE=public.ecr.aws/supabase/postgres-meta:v0.96.6
# Hour the @daily cron jobs fire in the local scheduler sim (staggered +1h/+2h
# for three of them — see jobs-cron-sim.mjs).
DAILY_HOUR_UTC=3

# ── 6. Runtime keys for the API containers (copied from the repo-root .env) ───
# These make the local stack behave like staging: real scrape/AI/email/billing
# providers. HOW TO OBTAIN: each has a placeholder in the repo-root .env — copy
# the real values here. Values below are SAMPLES; .env.local carries the real ones.
# DO: never commit .env.local. DON'T: paste production keys here — use the dev/test keys.
# dev project URL (shared-db mode + gen-config fallback)
VITE_SUPABASE_URL=REPLACE_ME
# dev project anon key (public by design)
VITE_SUPABASE_ANON_KEY=REPLACE_ME
# dev project service_role key — SECRET: server-side only, never expose to the browser bundle
SUPABASE_SERVICE_KEY=REPLACE_ME
# fc-...  (firecrawl.dev → API Keys)
FIRECRAWL_API_KEY=REPLACE_ME
# Anthropic sk-ant-... (console.anthropic.com → API Keys) — preferred key name for Anthropic.
# HOW TO OBTAIN: console.anthropic.com → API Keys.
# DO: keep server-side only. DON'T: prefix with VITE_.
ANTHROPIC_API_KEY=REPLACE_ME
# Anthropic sk-ant-... (legacy secondary env var read by providerRegistry)
AI_API_KEY=REPLACE_ME
# Google AI Studio key
GEMINI_API_KEY=REPLACE_ME
# Gemini model override for fast tier (classification, tagging, short extractions).
# HOW TO OBTAIN: valid model from Google AI Studio (gemini-3.8-flash, gemini-flash-latest).
# DO: use active non-retired model IDs. DON'T: use retired 2.x models.
GEMINI_MODEL_FAST=gemini-3.8-flash
# Gemini model override for deep tier (reports, synthesis, complex extractions).
# HOW TO OBTAIN: valid model from Google AI Studio (gemini-pro-latest).
# DO: use active non-retired model IDs. DON'T: use retired 2.x models.
GEMINI_MODEL_DEEP=gemini-pro-latest
# OpenAI model tiers (gpt-6-luna = the efficient GPT-6 for high-volume jobs;
# gpt-6-sol = longer-draft sibling)
OPENAI_MODEL_FAST=gpt-6-luna
OPENAI_MODEL_DEEP=gpt-6-luna
# Anthropic model tiers (haiku = high-speed execution, sonnet = everyday
# professional work: discoverability, workflow templates)
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_DEEP=claude-sonnet-5
# Perplexity model tiers (answer-engine citation sampling)
PERPLEXITY_MODEL_FAST=sonar
PERPLEXITY_MODEL_DEEP=sonar-pro
# AI provider fallback order; empty = code default (openai,gemini,anthropic).
# /admin/ai can re-order globally and per-area at runtime.
AI_PROVIDER_ORDER=
# sk-proj-... (platform.openai.com)
OPENAI_API_KEY=REPLACE_ME
# jina_... (jina.ai → API)
JINA_API_KEY=REPLACE_ME
# spider.cloud key
SPIDER_API_KEY=REPLACE_ME
# comma order, e.g. direct,spider,jina
SCRAPE_PROVIDER_ORDER=REPLACE_ME
# re_... (resend.com) — Mailpit captures locally; nothing is sent
RESEND_API_KEY=REPLACE_ME
# model id used by the AI service
VITE_AI_MODEL=REPLACE_ME
# /admin PIN (server-verified against ADMIN_PIN_HASH)
ADMIN_PIN=REPLACE_ME
# bcrypt hash of the PIN — how to obtain: `node -e "console.log(require('bcryptjs').hashSync('<pin>', 10))"`
ADMIN_PIN_HASH=REPLACE_ME
# bearer secret for admin/service endpoints (openssl rand -hex 32)
ADMIN_TOKEN_SECRET=REPLACE_ME
# rzp_test_... publishable id — leave EMPTY to defer payments locally
RAZORPAY_KEY_ID=REPLACE_ME
# rzp_... secret — NEVER bundled to the browser
RAZORPAY_KEY_SECRET=REPLACE_ME
# webhook signature secret from the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME
# publishable checkout key (safe for the browser bundle)
VITE_RAZORPAY_KEY_ID=REPLACE_ME
# n8n webhook the app calls (test URL only answers while the editor is open)
VITE_WEBHOOK_URL=https://vkaruna.app.n8n.cloud/webhook-test/datiq

# ── 7. DB migration from staging Supabase (scripts/migrate-from-supabase.sh) ──
# PREFERRED — CLI path (no database password needed):
#   SUPABASE_ACCESS_TOKEN — Supabase personal access token (dashboard → Account →
#     Access Tokens); also present in the repo-root .env.
#   SOURCE_PROJECT_REF — the staging project ref (dashboard URL subdomain),
#     e.g. aubwooslkkrprdxuiyvj (the dev/staging project).
#   The script runs `supabase db dump` (schema + public data) and restores into
#   the local DB. NOTE: auth-schema ROWS are not restored on this path — local
#   signon is a fresh signup (staging users are OAuth-only, no password hashes).
# ALTERNATIVE — direct path (needs the DB password):
#   SOURCE_DB_URL — the staging project's connection string (Supabase dashboard →
#   Project Settings → Database → Connection string → URI, session pooler):
#     postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   This path dumps the FULL database INCLUDING auth.users password hashes —
#   migrated accounts then sign in locally with their staging email + password.
# DO: run one path or the other (SOURCE_DB_URL wins if both are set). DON'T: run
# it against the production project — that is the cutover recipe, not a local rehearsal.
SOURCE_DB_URL=
SOURCE_PROJECT_REF=
# Supabase personal access token for the CLI migration path (dashboard → Account → Access Tokens).
SUPABASE_ACCESS_TOKEN=
# Optional: comma-separated PUBLIC tables to skip entirely during the local
# restore (e.g. audit_analytics_events,audit_pages for a faster rehearsal).
# Both the COPY block and its terminator are dropped (implemented in
# migrate-from-supabase.sh). DO: only skip tables you accept being absent from
# the rehearsal. DON'T: skip tables with FK dependents that DO get restored.
MIGRATE_EXCLUDE_TABLES=

# ── 8. Flags ──────────────────────────────────────────────────────────────────
# 1 = delete expired scheduled rows etc. (destructive). DO: 0 locally.
PURGE_ENABLED=0
# 1 = engagement email dispatcher runs. DO: 0 unless testing engagement flows.
ENGAGEMENT_ENABLED=0
# 0 = the local scheduler FIRES the 13 crons (Netlify/GCP stand-in); 1 disables
# the jobs from doing work — the parallel-run ownership rule (doc 05 §3b).
OPS_JOBS_DISABLED=0
# 1 = engagement emails are mocked (captured, not sent). DO: keep 1 locally.
ENGAGEMENT_MOCK_SEND=1
