{
  "name": "datiq",
  "private": true,
  "version": "1.0.0",
  "description": "DatIQ V1.0 — zero-code web extraction + enrichment. Single URL, batch, schedules, AI summaries, contacts, pricing, custom fields, shareable reports.",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.15.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/sync-prerender-assets.mjs",
    "preview": "vite preview",
    "version:bump": "node scripts/bump-version.mjs",
    "version:bump:minor": "node scripts/bump-version.mjs --minor",
    "version:bump:major": "node scripts/bump-version.mjs --major",
    "test": "vitest run",
    "test:unit": "vitest run src scripts --exclude '**/*.integration.test.*' --exclude '**/__tests__/system/**'",
    "test:contract": "vitest run netlify",
    "test:integration": "vitest run 'integration.test'",
    "test:system": "vitest run 'src/__tests__/system'",
    "test:db": "node scripts/db-verify.mjs && npm run verify:referral && npm run verify:workflows",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=chromium e2e/smoke.spec.js e2e/smoke/",
    "test:e2e:deploy": "playwright test --project=chromium e2e/smoke.spec.js e2e/smoke/",
    "test:e2e:smoke:all-browsers": "playwright test --project=chromium --project=firefox --project=webkit e2e/smoke.spec.js e2e/smoke/",
    "test:e2e:journeys": "playwright test e2e/journeys/",
    "test:e2e:a11y": "playwright test e2e/a11y/",
    "test:e2e:visual": "playwright test --project=chromium e2e/visual/",
    "test:smoke": "npm run test:e2e:smoke",
    "test:security": "node scripts/security-check.mjs",
    "smoke": "node scripts/smoke-prod.mjs",
    "smoke:prod": "node scripts/smoke-prod.mjs https://datiq.app",
    "smoke:staging": "node scripts/smoke-prod.mjs ${STAGING_URL:-https://staging--datiqapp.netlify.app}",
    "readiness": "node .claude/skills/production-readiness/scripts/audit.mjs",
    "test:all": "node scripts/test-all.mjs",
    "test-all": "node scripts/test-all.mjs",
    "test:prepush": "node scripts/test-all.mjs --prepush",
    "test:release": "node scripts/release-regression.mjs",
    "ci:install-hook": "node scripts/install-hook.mjs",
    "migrate:prod": "node scripts/migrate-prod.mjs",
    "build:sql": "node scripts/build-run-all.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "prerender": "node scripts/prerender.mjs",
    "check:prerender": "node scripts/check-prerender-assets.mjs",
    "build:sitemap": "node scripts/build-sitemap.mjs",
    "verify:referral": "node scripts/verify-referral-e2e.mjs",
    "sync:prerender": "node scripts/sync-prerender-assets.mjs",
    "import:cloudrun": "node scripts/import-workflows-cloudrun.mjs",
    "test:workflow": "node scripts/test-workflow-pipeline.mjs",
    "verify:rls": "node scripts/verify-workflow-rls.mjs",
    "verify:discoverability": "node scripts/verify-discoverability-e2e.mjs",
    "verify:workflows": "node scripts/verify-workflows-e2e.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.460.0",
    "razorpay": "^2.9.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0"
  }
}
