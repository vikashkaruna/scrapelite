# ─────────────────────────────────────────────────────────────────────────────
# DatIQ — environment configuration
#
# Copy this file to `.env` and fill in the values you have. EVERYTHING here is
# OPTIONAL: with no keys set, DatIQ runs in a local mock mode (mock extraction
# and AI fallback; history saved to browser localStorage). Paid plans are never
# granted unless VITE_ENABLE_DEMO_BILLING=true is explicitly set for local demos.
#
# As soon as a given key is present, the matching real integration switches on.
# Vite only exposes vars prefixed with VITE_ to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (database connection + key) ─────────────────────────────────────
# Project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=
# Public anon key (safe for the browser; Row Level Security must be enabled).
VITE_SUPABASE_ANON_KEY=

# ── Firecrawl (real webpage extraction) ──────────────────────────────────────
# The real key is server-only. Set VITE_ENABLE_EXTRACT=true as a browser feature
# flag once FIRECRAWL_API_KEY is configured in Netlify or the local function env.
FIRECRAWL_API_KEY=
VITE_ENABLE_EXTRACT=

# ── AI summary provider ──────────────────────────────────────────────────────
# Server-only provider credentials. The browser calls /api/ai and falls back to
# deterministic mock content when no provider is configured.
AI_API_KEY=
# Optional alternatives for the server-side provider chain.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Model id used for summaries.
VITE_AI_MODEL=claude-haiku-4-5-20251001

# ── Webhook (optional) ───────────────────────────────────────────────────────
# If set, every saved extraction is POSTed as JSON to this URL (e.g. a Zapier /
# n8n / Make webhook, or your own endpoint), and "Send email" posts an
# "email.send" event here for delivery. A scheme-less value is auto-prefixed with
# https:// so it can't accidentally resolve to the app's own origin.
#
# NOTE: Vite bakes VITE_* values in at BUILD time (and dev reads .env once at
# startup). To change the webhook URL WITHOUT rebuilding — in dev or prod — set
# `webhookUrl` in public/runtime-config.js instead; it's read at runtime and
# overrides this value. Leave that file's value empty to use this one.
VITE_WEBHOOK_URL=

# ── Footer page links (optional) ─────────────────────────────────────────────
# When set, the corresponding link appears in the site footer. When unset (or
# empty), the link is hidden entirely — no broken anchors. Use full URLs or
# relative paths. These are baked in at build time (Vite env vars).
VITE_LINK_ABOUT=
VITE_LINK_BLOG=
VITE_LINK_PRICING=
VITE_LINK_CHANGELOG=

# ── Payment integration (Stripe + Razorpay/UPI) ───────────────────────────────
# Set EITHER Stripe OR Razorpay (or both). If neither is set, paid upgrades fail
# safely. Set VITE_ENABLE_DEMO_BILLING=true only for an intentional local demo.
#
# VITE_PAYMENT_PROVIDER controls routing: "auto" (default) picks Stripe for
# USD/EUR/GBP/SGD and Razorpay for INR/AED. Override with "stripe" or "razorpay".
VITE_PAYMENT_PROVIDER=auto
VITE_ENABLE_DEMO_BILLING=false

# Stripe — publishable key goes in VITE_ (safe for browser). Secret key is
# server-only (Netlify function env var — do NOT prefix with VITE_).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe recurring price IDs (create in Stripe Dashboard → Products → Add price → Recurring).
VITE_STRIPE_PRICE_SELECT=price_...
VITE_STRIPE_PRICE_PRO=price_...
VITE_STRIPE_PRICE_BUSINESS=price_...
VITE_STRIPE_PRICE_AGENCY=price_...
# Stripe one-time price IDs for top-up bundles
VITE_STRIPE_PRICE_EXTRACTIONS_BUNDLE=price_...
VITE_STRIPE_PRICE_SCHEDULER_ADDON=price_...
VITE_STRIPE_PRICE_HUBSPOT_ADDON=price_...

# Server-side Stripe mapping. Set these in Netlify without VITE_ so checkout and
# verification map every plan to its expected price (the VITE values above are
# retained only as backwards-compatible fallbacks).
STRIPE_PRICE_SELECT=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...
STRIPE_PRICE_AGENCY=price_...
STRIPE_PRICE_EXTRACTIONS_BUNDLE=price_...
STRIPE_PRICE_SCHEDULER_ADDON=price_...
STRIPE_PRICE_HUBSPOT_ADDON=price_...

# Razorpay — key ID is public (VITE_), key secret is server-only.
VITE_RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# Admin access is disabled until one of these server-only credentials is set.
# Prefer a SHA-256 hash: printf '%s' 'long-random-pin' | shasum -a 256
ADMIN_PIN_HASH=
ADMIN_TOKEN_SECRET=

# Razorpay subscription plan IDs (create in Razorpay Dashboard → Subscriptions → Plans).
VITE_RAZORPAY_PLAN_SELECT=plan_...
VITE_RAZORPAY_PLAN_PRO=plan_...
VITE_RAZORPAY_PLAN_BUSINESS=plan_...
VITE_RAZORPAY_PLAN_AGENCY=plan_...
