# ─────────────────────────────────────────────────────────────────────────────
# DatIQ — environment configuration
#
# Copy this file to `.env` and fill in the values you have. EVERYTHING here is
# OPTIONAL: with no keys set, DatIQ runs in a fully-interactive demo mode
# (mock extraction + AI summary, history saved to your browser's localStorage).
#
# As soon as a given key is present, the matching real integration switches on.
# Vite only exposes vars prefixed with VITE_ to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (database connection + key) ─────────────────────────────────────
# Project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=
# Public anon key (safe for the browser; Row Level Security must be enabled).
VITE_SUPABASE_ANON_KEY=

# ── Firecrawl (real webpage extraction) ──────────────────────────────────────
# Get a key at https://firecrawl.dev. Without it, extraction is mocked.
VITE_ENABLE_EXTRACT=false
FIRECRAWL_API_KEY=

# ── AI summary provider ──────────────────────────────────────────────────────
# Anthropic API key (Claude). Server-side key for Netlify/Cloud Run functions.
ANTHROPIC_API_KEY=
# Legacy alias for Anthropic key
AI_API_KEY=
# Google AI Studio API key (Gemini)
GEMINI_API_KEY=
# OpenAI API key (server-side; with it set, OpenAI leads the fallback chain)
OPENAI_API_KEY=
# ── AI model tiers ───────────────────────────────────────────────────────────
# Default priority order (owner-set 2026-09-30): OpenAI → Gemini → Claude.
# Every tier is overridable per environment here, and at runtime from
# /admin/ai (stored config always wins over env; env always wins over the
# registry pins in src/lib/providerRegistry.js). Leave any var empty to ride
# that layer's default.
#
# Chain order override, comma-separated (empty = openai,gemini,anthropic):
AI_PROVIDER_ORDER=
# OpenAI — GPT-6 Luna (efficient GPT-6 for high-volume jobs; gpt-6-sol is the
# longer-draft sibling). Used for extraction, enrichment and the fast tier.
OPENAI_MODEL_FAST=gpt-6-luna
OPENAI_MODEL_DEEP=gpt-6-luna
# Gemini — 3.8 Flash for speed & grounding (discoverability, templates
# execution), Pro for deep synthesis. Classification ("lightweight
# automation") ships with gemini-3.5-flash-lite as its per-area default.
GEMINI_MODEL_FAST=gemini-3.8-flash
GEMINI_MODEL_DEEP=gemini-pro-latest
# Anthropic — Haiku 4.5 for high-speed execution, Sonnet 5 for everyday
# professional work (discoverability, workflow templates).
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_DEEP=claude-sonnet-5
# Perplexity — answer-engine citation sampling (sonar family).
PERPLEXITY_MODEL_FAST=sonar
PERPLEXITY_MODEL_DEEP=sonar-pro
# Generic single-model pins (pin BOTH tiers; predates tiering — prefer the
# _FAST/_DEEP vars above). Legacy name for Anthropic is AI_MODEL.
#OPENAI_MODEL=
#GEMINI_MODEL=
#AI_MODEL=
# Model id used for summaries.
VITE_AI_MODEL=claude-haiku-4-5-20251001

# ── Webhook (optional) ───────────────────────────────────────────────────────
# If set, every saved extraction is POSTed as JSON to this URL (e.g. a Zapier /
# n8n / Make webhook, or your own endpoint), and "Send email" posts an
# "email.send" event here for delivery. A scheme-less value is auto-prefixed with
# https:// so it can't accidentally resolve to the app's own origin.
#
# NOTE: Vite bakes VITE_* values in at BUILD time (and dev reads .env once at
# startup). To change the webhook URL WITHOUT rebuilding — in dev or prod — set
# `webhookUrl` in public/runtime-config.js instead; it's read at runtime and
# overrides this value. Leave that file's value empty to use this one.
VITE_WEBHOOK_URL=

# Server-only envelope key for HubSpot/Notion/Airtable/Slack credentials.
# Set this in Netlify and keep it out of all VITE_* variables.
INTEGRATION_SECRETS_KEY=

# ── Footer page links (optional) ─────────────────────────────────────────────
# When set, the corresponding link appears in the site footer. When unset (or
# empty), the link is hidden entirely — no broken anchors. Use full URLs or
# relative paths. These are baked in at build time (Vite env vars).
VITE_LINK_ABOUT=
VITE_LINK_BLOG=
VITE_LINK_PRICING=
VITE_LINK_CHANGELOG=

# ── Payment integration (Stripe + Razorpay/UPI) ───────────────────────────────
# Set EITHER Stripe OR Razorpay (or both). If neither is set, upgrades are
# simulated locally in demo mode — useful for development.
#
# VITE_PAYMENT_PROVIDER controls routing: "auto" (default) picks Stripe for
# USD/EUR/GBP/SGD and Razorpay for INR/AED. Override with "stripe" or "razorpay".
VITE_PAYMENT_PROVIDER=auto

# Stripe — publishable key goes in VITE_ (safe for browser). Secret key is
# server-only (Netlify function env var — do NOT prefix with VITE_).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe recurring price IDs (create in Stripe Dashboard → Products → Add price → Recurring).
VITE_STRIPE_PRICE_SELECT=price_...
VITE_STRIPE_PRICE_PRO=price_...
VITE_STRIPE_PRICE_BUSINESS=price_...
VITE_STRIPE_PRICE_AGENCY=price_...
# Stripe one-time price IDs for top-up bundles
VITE_STRIPE_PRICE_EXTRACTIONS_BUNDLE=price_...
VITE_STRIPE_PRICE_SCHEDULER_ADDON=price_...
VITE_STRIPE_PRICE_HUBSPOT_ADDON=price_...

# Razorpay — key ID is public (VITE_), key secret is server-only.
VITE_RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# Razorpay subscription plan IDs (create in Razorpay Dashboard → Subscriptions → Plans).
VITE_RAZORPAY_PLAN_SELECT=plan_...
VITE_RAZORPAY_PLAN_PRO=plan_...
VITE_RAZORPAY_PLAN_BUSINESS=plan_...
VITE_RAZORPAY_PLAN_AGENCY=plan_...

# ── v2 workflow pipeline: n8n + MCP orchestrator ──────────────────────────
# The 17 n8n workflow JSONs (n8n/workflows/), the workflow_events queue
# (migration 0018/0022_workflow_events.sql), workflow-orchestrator.js and
# /admin/automation all shipped — but none of these three vars has ever been
# set anywhere (confirmed: absent from this file before this session, and
# absent from every Netlify context). Without them the orchestrator has no
# n8n instance to dispatch to and no shared secret to sign with, so the
# whole pipeline sits deployed but unexercised. See
# docs/N8N-DEPLOYMENT-STATUS.md for what's left to actually turn it on.
N8N_BASE_URL=https://your-n8n-host.example.com
N8N_WEBHOOK_SECRET=  # same value as DATIQ_N8N_API_KEY configured inside n8n
WORKFLOW_ORCHESTRATOR_TOKEN=  # openssl rand -hex 32 — bearer token for the manual /run-now HTTP trigger
