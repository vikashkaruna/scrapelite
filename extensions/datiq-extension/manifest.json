{
  "manifest_version": 3,
  "name": "DatIQ — Extract & Enrich",
  "version": "1.0.0",
  "description": "Right-click any page to extract it with DatIQ. Send the result to your dashboard, HubSpot, Notion, Airtable, or 5,000+ apps via Zapier.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DatIQ — Extract this page",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "https://datiq.app/*",
    "https://staging--datiqapp.netlify.app/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "icons/*.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Extract the current page with DatIQ"
    }
  },
  "action_browser_action": {
    "default_title": "DatIQ"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
